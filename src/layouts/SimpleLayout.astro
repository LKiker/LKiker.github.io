---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { pageTitle, simpleViewHref = '/', simpleViewLabel = 'full view' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&family=Space+Grotesk:wght@500;600&display=swap" rel="stylesheet">
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="ocean simple-page">
      <div class="simple-container">
        <slot />
      </div>
      <Footer simpleViewHref={simpleViewHref} simpleViewLabel={simpleViewLabel} />
    </div>
  </body>
</html>

<style>
  /* Plain native scrolling on purpose — no ScrollSmoother/GSAP anywhere
     in this layout. This view exists specifically as the lightweight,
     low-motion, recruiter-friendly alternative to the immersive main
     page, so it should scroll exactly the way a normal webpage (or a
     resume) does: instantly, natively, with zero JS in the loop. */
  .simple-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .simple-container {
    flex: 1;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
</style>