---
---
<div class="depth-gauge">
  <span class="depth-label">depth</span>
  <div class="depth-track">
    <div class="depth-fill" id="depth-fill"></div>
    <div class="depth-marker" id="depth-marker">
      <span class="depth-value"><span id="depth-number">0.0</span><span class="depth-unit">m</span></span>
    </div>
  </div>
</div>

<style>
  .depth-gauge {
    position: fixed;
    top: 2rem;
    bottom: 2rem;
    left: 1.5rem;
    z-index: 50;
    font-family: var(--font-mono);
    color: var(--color-accent);
    letter-spacing: 0.06em;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .depth-label {
    font-size: 0.6rem;
    opacity: 0.6;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .depth-track {
    position: relative;
    flex: 1;
    width: 3px;
    border-radius: 2px;
    background: rgba(94, 234, 212, 0.15);
  }

  .depth-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: var(--color-accent);
    border-radius: 2px;
    will-change: height;
  }

  .depth-marker {
    position: absolute;
    left: 1.1rem;
    top: 0;
    transform: translateY(-50%);
    white-space: nowrap;
    will-change: top;
  }

  /* Fixed width, right-aligned, reserved for the worst case ("3682.0m").
     Without this the box grows every time the number gains a digit
     (e.g. 99.9 -> 100.0), which is what reads as the gauge "moving" even
     though its left anchor never actually changes. Locking the width
     means the box footprint never changes again regardless of value, so
     there's nothing left to shift. tabular-nums keeps individual digit
     widths consistent within that fixed box too. */
  .depth-value {
    display: inline-block;
    width: 3.5rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .depth-value {
    font-size: 0.75rem;
    font-weight: 500;
  }

  .depth-unit {
    font-size: 0.6rem;
  }

  /* The gauge is decorative chrome, not primary navigation, and on
     narrow screens there's no room for a fixed sidebar without it
     overlapping content. Hidden at the same breakpoint used elsewhere
     on the site (e.g. ProjectCard's stacked layout). */
  @media (max-width: 800px) {
    .depth-gauge {
      display: none;
    }
  }
</style>

<script>
  import { getVirtualScrollY } from '../scripts/scrollState';

  const MAX_DEPTH = 3682; // aesthetic scale mapped across full page scroll

  const numberEl = document.getElementById('depth-number');
  const fillEl = document.getElementById('depth-fill');
  const markerEl = document.getElementById('depth-marker');
  let ticking = false;

  function updateDepth() {
    const scrollTop = getVirtualScrollY(); // was: window.scrollY
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? Math.min(1, Math.max(0, scrollTop / docHeight)) : 0;
    const depth = progress * MAX_DEPTH;

    if (numberEl) numberEl.textContent = depth.toFixed(1);
    if (fillEl) fillEl.style.height = `${progress * 100}%`;
    if (markerEl) markerEl.style.top = `${progress * 100}%`;

    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(updateDepth);
      ticking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  updateDepth();
</script>