---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, eyebrow, description, tags, links, media } = project;
---

<article class="project-card" data-project-id={project.id} data-category={project.category}>
    <div class="card-content">
        <p class="eyebrow">{eyebrow}</p>
        <h3 class="title">{title}</h3>
        <p class="description">{description}</p>

        {tags.length > 0 && (
        <ul class="tags">
            {tags.map((tag) => (
            <li class="tag">{tag}</li>
            ))}
        </ul>
        )}

        <div class="links">
        {links.github && (
            <a class="link" href={links.github} target="_blank" rel="noopener noreferrer">
            View on GitHub →
            </a>
        )}
        {links.live && (
            <a class="link" href={links.live} target="_blank" rel="noopener noreferrer">
            View live →
            </a>
        )}
        </div>
    </div>
</article>