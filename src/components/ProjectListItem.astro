---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, tags, links, media } = project;

// Simple View skips project.media.video entirely — no player JS ships
// on this page, so a raw <video> tag would just sit there unplayed.
// gif and poster are both plain <img> tags, so they render and animate
// (or not) with zero JS cost, which keeps this page's static, lightweight
// footprint intact.
const hasThumb = Boolean(media.gif || media.poster);
---

<article class="project-row" data-project-id={project.id} data-category={project.category}>
    <div class="row-header">
        <h3 class="title">{title}</h3>
        <div class="links">
            {links.github && (
                <a class="link" href={links.github} target="_blank" rel="noopener noreferrer">
                    GitHub →
                </a>
            )}
            {links.live && (
                <a class="link" href={links.live} target="_blank" rel="noopener noreferrer">
                    Live →
                </a>
            )}
        </div>
    </div>

    {hasThumb && (
        <div class="media-thumb">
            {media.gif ? (
                <>
                    <img
                        class="thumb-gif"
                        src={media.gif.src}
                        width={media.gif.width}
                        height={media.gif.height}
                        alt={`${title} preview`}
                        loading="lazy"
                        decoding="async"
                    />
                    {media.poster && (
                        <img
                            class="thumb-poster thumb-gif-fallback"
                            src={media.poster}
                            alt={`${title} preview`}
                            loading="lazy"
                            decoding="async"
                        />
                    )}
                </>
            ) : (
                <img
                    class="thumb-poster"
                    src={media.poster}
                    alt={`${title} preview`}
                    loading="lazy"
                    decoding="async"
                />
            )}
        </div>
    )}

    <p class="description">{description}</p>

    {tags.length > 0 && (
        <div class="tools-section">
            <span class="tools-label">Built with</span>
            <ul class="tags">
                {tags.map((tag) => (
                    <li class="tag">{tag}</li>
                ))}
            </ul>
        </div>
    )}
</article>

<style>
    .project-row {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    /* Divider between projects — :not(:last-child) still works here even
       though each row is rendered by a separate component instance,
       since it's evaluated against actual DOM sibling order, not
       per-component. Skipped on the last row so it doesn't duplicate the
       section's own bottom edge. */
    .project-row:not(:last-child) {
        padding-bottom: 2rem;
        border-bottom: 1px solid rgba(94, 234, 212, 0.1);
    }

    .row-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .title {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--color-surface-text);
        margin: 0;
    }

    .links {
        display: flex;
        gap: 1rem;
        flex-shrink: 0;
    }

    .link {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--color-accent);
        text-decoration: none;
        white-space: nowrap;
    }

    .link:hover {
        text-decoration: underline;
    }

    /* One fixed aspect ratio for every thumbnail, regardless of the
       source gif/poster's native dimensions. Letting each gif dictate
       its own box (via its real width/height) is what caused the
       vertical stretching — a handful of gifs have tall, narrow native
       ratios, so their boxes ballooned in height. Fixing the box and
       cropping into it with object-fit: cover keeps every row the same
       shape, at the cost of cropping some content on unusually tall or
       wide source media. */
    .media-thumb {
        width: 100%;
        max-width: 420px;
        aspect-ratio: 16 / 10;
        border-radius: 8px;
        overflow: hidden;
        position: relative;
        background: rgba(94, 234, 212, 0.05);
    }

    .thumb-gif,
    .thumb-poster {
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* Bias the crop toward the top of the source image — most of
           these gifs/screenshots have their focal content (UI, subject)
           nearer the top than the bottom. Adjust to "center" if a
           specific thumbnail crops out something important. */
        object-position: center top;
        display: block;
    }

    .thumb-gif-fallback {
        display: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .thumb-gif {
            display: none;
        }

        .thumb-gif-fallback {
            display: block;
        }
    }

    @media (max-width: 600px) {
        .media-thumb {
            max-width: none;
        }
    }

    .description {
        font-family: var(--font-body);
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--color-muted-text);
        margin: 0;
        max-width: 60ch;
    }

    .tools-section {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-top: 0.25rem;
    }

    .tools-label {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-muted-text);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .tag {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        padding: 0.2rem 0.55rem;
        background: rgba(94, 234, 212, 0.1);
        color: var(--color-accent);
        border-radius: 999px;
    }
</style>