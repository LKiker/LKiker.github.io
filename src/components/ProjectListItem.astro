---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, tags, links } = project;
---

<article class="project-row" data-project-id={project.id} data-category={project.category}>
    <div class="row-header">
        <h3 class="title">{title}</h3>
        <div class="links">
            {links.github && (
                <a class="link" href={links.github} target="_blank" rel="noopener noreferrer">
                    GitHub →
                </a>
            )}
            {links.live && (
                <a class="link" href={links.live} target="_blank" rel="noopener noreferrer">
                    Live →
                </a>
            )}
        </div>
    </div>

    <p class="description">{description}</p>

    {tags.length > 0 && (
        <div class="tools-section">
            <span class="tools-label">Built with</span>
            <ul class="tags">
                {tags.map((tag) => (
                    <li class="tag">{tag}</li>
                ))}
            </ul>
        </div>
    )}
</article>

<style>
    .project-row {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    /* Divider between projects — :not(:last-child) still works here even
       though each row is rendered by a separate component instance,
       since it's evaluated against actual DOM sibling order, not
       per-component. Skipped on the last row so it doesn't duplicate the
       section's own bottom edge. */
    .project-row:not(:last-child) {
        padding-bottom: 2rem;
        border-bottom: 1px solid rgba(94, 234, 212, 0.1);
    }

    .row-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .title {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--color-surface-text);
        margin: 0;
    }

    .links {
        display: flex;
        gap: 1rem;
        flex-shrink: 0;
    }

    .link {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--color-accent);
        text-decoration: none;
        white-space: nowrap;
    }

    .link:hover {
        text-decoration: underline;
    }

    .description {
        font-family: var(--font-body);
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--color-muted-text);
        margin: 0;
        max-width: 60ch;
    }

    .tools-section {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-top: 0.25rem;
    }

    .tools-label {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-muted-text);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .tag {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        padding: 0.2rem 0.55rem;
        background: rgba(94, 234, 212, 0.1);
        color: var(--color-accent);
        border-radius: 999px;
    }
</style>