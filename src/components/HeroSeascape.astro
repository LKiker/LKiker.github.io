---
// HeroSeascape.astro
// Hero-scoped WebGL surface: raymarched waves (horizon view) with a
// centered overhead sun-ray glow, fading to transparent at the bottom
// edge so it blends into the page's .ocean gradient rather than ending
// in a hard rectangle.
//
// Wave/lightShafts/bubble technique © greenbird10, CC BY-NC-SA 3.0
// (https://creativecommons.org/licenses/by-nc-sa/3.0/) — non-commercial use
// is covered for a personal portfolio, but keep this attribution intact,
// and credit it again somewhere visible (footer/colophon/README) rather
// than relying on a code comment alone to satisfy the license.
//
---

<canvas id="hero-seascape-canvas" class="hero-seascape-canvas" aria-hidden="true"></canvas>

<style>
  .hero-seascape-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
  }
</style>

<script>
  const VERT_SRC = `
    attribute vec2 aPosition;
    void main() {
      gl_Position = vec4(aPosition, 0.0, 1.0);
    }
  `;

  const FRAG_SRC = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
      precision highp float;
    #else
      precision mediump float;
    #endif

    uniform vec2 iResolution;
    uniform float iTime;

    // --- wave / seascape (c) greenbird10, CC BY-NC-SA 3.0 ---

    float hash(vec2 p) {
      return 0.5*(sin(dot(p, vec2(271.319, 413.975)) + 1217.13*p.x*p.y)) + 0.5;
    }

    float noise(vec2 p) {
      vec2 w = fract(p);
      w = w * w * (3.0 - 2.0*w);
      p = floor(p);
      return mix(
        mix(hash(p+vec2(0,0)), hash(p+vec2(1,0)), w.x),
        mix(hash(p+vec2(0,1)), hash(p+vec2(1,1)), w.x), w.y);
    }

    float map_octave(vec2 uv) {
      uv = (uv + noise(uv)) / 2.5;
      uv = vec2(uv.x*0.6-uv.y*0.8, uv.x*0.8+uv.y*0.6);
      vec2 uvsin = 1.0 - abs(sin(uv));
      vec2 uvcos = abs(cos(uv));
      uv = mix(uvsin, uvcos, uvsin);
      float val = 1.0 - pow(uv.x * uv.y, 0.65);
      return val;
    }

    float map(vec3 p) {
      vec2 uv = p.xz + iTime/2.0;
      float amp = 0.6, freq = 2.0, val = 0.0;
      for (int i = 0; i < 3; ++i) {
        val += map_octave(uv) * amp;
        amp *= 0.3;
        uv *= freq;
      }
      uv = p.xz - 1000.0 - iTime/2.0;
      amp = 0.6; freq = 2.0;
      for (int i = 0; i < 3; ++i) {
        val += map_octave(uv) * amp;
        amp *= 0.3;
        uv *= freq;
      }
      return val + 3.0 - p.y;
    }

    vec3 getNormal(vec3 p) {
      float eps = 3.0/iResolution.x;
      vec3 px = p + vec3(eps, 0, 0);
      vec3 pz = p + vec3(0, 0, eps);
      return normalize(vec3(map(px), eps, map(pz)));
    }

    float raymarch(vec3 ro, vec3 rd, out vec3 outP, out float outT) {
      float l = 0.0, r = 26.0;
      float dist = 1000000.0;
      for (int i = 0; i < 12; ++i) {
        float mid = (r+l)/2.0;
        float mapmid = map(ro + rd*mid);
        dist = min(dist, abs(mapmid));
        if (mapmid > 0.0) { l = mid; } else { r = mid; }
        if (r - l < 1.0/iResolution.x) break;
      }
      outP = ro + rd*l;
      outT = l;
      return dist;
    }

    // --- directional sun-ray glow (see SunRays.astro) ---

    float rayStrength(vec2 raySource, vec2 rayRefDirection, vec2 coord, float seedA, float seedB, float speed) {
      vec2 sourceToCoord = coord - raySource;
      float cosAngle = dot(normalize(sourceToCoord), rayRefDirection);
      return clamp(
        (0.45 + 0.15 * sin(cosAngle * seedA + iTime * speed)) +
        (0.3 + 0.2 * cos(-cosAngle * seedB + iTime * speed)),
        0.0, 1.0) *
        clamp((iResolution.x - length(sourceToCoord)) / iResolution.x, 0.5, 1.0);
    }

    void main() {
      vec3 ro = vec3(0.0, 0.0, 2.0);
      vec3 lightPos = vec3(8.0, 3.0, -3.0);

      vec2 uv = gl_FragCoord.xy;
      uv = (-iResolution.xy + 2.0*uv) / iResolution.y;
      uv.y *= 0.5;
      uv.x *= 0.45;

      vec3 rd = normalize(vec3(uv, -1.0));
      vec3 hitPos;
      float hitT;
      // Matched to the site's updated --color-shallow (#0f516a) and
      // --color-surface-aqua (#175f78) CSS tokens, both sampled from the
      // reference photo's ambient water tone (away from the sunburst,
      // which this shader renders separately via sunGlow/rays).
      vec3 seaColor = vec3(15.0, 81.0, 106.0)/255.0;      // --color-shallow
      vec3 highlightColor = vec3(23.0, 95.0, 120.0)/255.0; // --color-surface-aqua
      vec3 color;

      float dist = raymarch(ro, rd, hitPos, hitT);
      float diffuse = dot(getNormal(hitPos), rd) * 0.5 + 0.5;
      color = mix(seaColor, highlightColor, diffuse);

      // Concentrate the specular sparkle near the sun's position instead of
      // letting it show evenly across the whole wave field — this is what
      // makes the middle read as "that's where the light is coming from"
      // rather than just having some rays drawn on top.
      vec2 sunPx = vec2(iResolution.x * 0.5, iResolution.y * 0.82);
      float sunDist = length(gl_FragCoord.xy - sunPx) / iResolution.y;
      float sunGlow = exp(-sunDist*sunDist*2.2);
      color += pow(diffuse, 7.0) * (0.35 + 0.6*sunGlow);

      vec3 ref = normalize(refract(hitPos-lightPos, getNormal(hitPos), 0.05));
      float refraction = clamp(dot(ref, rd), 0.0, 1.0);
      color += vec3(245.0, 250.0, 220.0)/255.0 * 0.6 * pow(refraction, 1.5);

      // Blend distant/unconverged surface into a smooth haze instead of a
      // hard silhouette line. pow(x, 0.2) saturates almost immediately for
      // small x, which is what was producing the sharp edge — two wide
      // smoothstep ramps instead, one on raymarch residual (how well it
      // converged) and one on ray depth (hitT — how far along the ray the
      // hit was), so far wave detail fades out gradually like real
      // underwater light scatter rather than switching off.
      float residualFog = smoothstep(0.0, 1.2, dist);
      float depthFog = smoothstep(8.0, 24.0, hitT);
      float fog = clamp(max(residualFog, depthFog), 0.0, 1.0);
      vec3 col = mix(color, seaColor, fog);

      // Sun rays converging from a single overhead source (centered, mostly
      // vertical direction) rather than a diagonal cross-light pair — this
      // reads as a sunburst punching straight down through the surface.
      // Higher seedA/seedB = faster oscillation = thinner individual rays.
      // pow(rays, N) sharpens the field, suppressing everything but the
      // peaks so it reads as distinct thin rays instead of a broad glow.
      vec2 rayCoord = vec2(gl_FragCoord.x, iResolution.y - gl_FragCoord.y);
      vec2 rayPos1 = vec2(iResolution.x * 0.5, iResolution.y * -0.15);
      vec2 rayRefDir1 = normalize(vec2(0.0, 1.0));
      vec2 rayPos2 = vec2(iResolution.x * 0.52, iResolution.y * -0.05);
      vec2 rayRefDir2 = normalize(vec2(0.03, 1.0));
      float rays1 = pow(rayStrength(rayPos1, rayRefDir1, rayCoord, 70.0, 45.0, 1.5), 2.5);
      float rays2 = pow(rayStrength(rayPos2, rayRefDir2, rayCoord, 55.0, 38.0, 1.1), 2.5);
      col += vec3(1.0, 0.98, 0.9) * (rays1 * 0.22 + rays2 * 0.16);

      col = (col*col + sin(col))/vec3(1.8, 1.8, 1.9);

      // Radial falloff centered on the sun position (same point the rays
      // converge on) rather than the frame's geometric center — this is
      // what makes the middle of the waves genuinely brighter, not just
      // decorated with ray streaks on top of an otherwise flat field.
      col *= mix(0.45, 1.35, sunGlow);

      // Blend the bottom edge of the canvas into the page's .ocean gradient
      // behind it instead of ending in a hard rectangle — fade to
      // transparent over the bottom ~35% of the frame so the hero seam
      // dissolves into the rest of the descent.
      float bottomFade = smoothstep(0.0, 0.35, gl_FragCoord.y / iResolution.y);

      gl_FragColor = vec4(col, bottomFade);
    }
  `;

  function compileShader(gl: WebGLRenderingContext, type: number, source: string) {
    const shader = gl.createShader(type);
    if (!shader) return null;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.warn('HeroSeascape shader compile error:', gl.getShaderInfoLog(shader));
      gl.deleteShader(shader);
      return null;
    }
    return shader;
  }

  function setup() {
    const canvas = document.getElementById('hero-seascape-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: false });
    if (!gl) {
      canvas.style.display = 'none';
      return;
    }

    const vertShader = compileShader(gl, gl.VERTEX_SHADER, VERT_SRC);
    const fragShader = compileShader(gl, gl.FRAGMENT_SHADER, FRAG_SRC);
    if (!vertShader || !fragShader) {
      canvas.style.display = 'none';
      return;
    }

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vertShader);
    gl.attachShader(program, fragShader);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.warn('HeroSeascape program link error:', gl.getProgramInfoLog(program));
      canvas.style.display = 'none';
      return;
    }
    gl.useProgram(program);

    const positionBuffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPosition = gl.getAttribLocation(program, 'aPosition');
    gl.enableVertexAttribArray(aPosition);
    gl.vertexAttribPointer(aPosition, 2, gl.FLOAT, false, 0, 0);

    const uResolution = gl.getUniformLocation(program, 'iResolution');
    const uTime = gl.getUniformLocation(program, 'iTime');

    // Raymarching is expensive per-pixel — render smaller than CSS size
    // and let the browser upscale. Tune RENDER_SCALE down further (e.g.
    // 0.35) if this still chugs on mid-tier mobile GPUs.
    const RENDER_SCALE = 0.4;
    const MAX_DPR = 1.25;

    let width = 0;
    let height = 0;

    function resize() {
      if (!gl || !canvas) return;
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR) * RENDER_SCALE;
      width = Math.max(1, Math.floor(rect.width * dpr));
      height = Math.max(1, Math.floor(rect.height * dpr));
      canvas.width = width;
      canvas.height = height;
      gl.viewport(0, 0, width, height);
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let inView = true;
    let rafId = 0;

    function render(now: number) {
      if (!gl) return;
      const t = prefersReducedMotion ? 0 : now / 1000;
      gl.uniform2f(uResolution, width, height);
      gl.uniform1f(uTime, t);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      if (!prefersReducedMotion && inView && !document.hidden) {
        rafId = requestAnimationFrame(render);
      }
    }

    function start() {
      cancelAnimationFrame(rafId);
      if (prefersReducedMotion) {
        render(0); // single static frame, no loop
        return;
      }
      rafId = requestAnimationFrame(render);
    }

    // Only run the raymarcher while the hero is actually visible — this is
    // the perf lever that makes an otherwise-heavy shader affordable.
    const observer = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView) start();
        else cancelAnimationFrame(rafId);
      },
      { threshold: 0 }
    );
    observer.observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else if (inView) {
        start();
      }
    });

    window.addEventListener('resize', resize);
    resize();
    start();
  }

  setup();
</script>