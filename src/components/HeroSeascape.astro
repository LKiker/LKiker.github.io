---
// HeroSeascape.astro
// Hero-scoped WebGL surface: fullscreen fragment shader, camera above a
// flat y=0 plane looking across it toward the horizon, with wave detail
// faked entirely through height/normal-based shading at the ray/plane hit
// point (not real mesh displacement).
//
// This is a near-complete port of a CC BY-NC-SA 3.0 licensed ShaderToy
// seascape shader — sky rendering and the visible sun disc have been
// stripped out per request (swapped for a flat FOG_COLOR placeholder) so
// they can be added back deliberately later. Everything else (seaHeight,
// seaNormal, the ray/plane intersection, the fresnel/diffuse sea shading)
// is a direct adaptation. Keep this attribution intact, and credit the
// source again somewhere visible (footer/colophon) — if you still have
// the original ShaderToy link, drop it in here.
//
// Usage: identical to before — drop <HeroSeascape /> as the first child
// inside your .hero div in index.astro, position: absolute/inset:0 behind
// .hero-content (which needs z-index + position:relative to sit on top).
---

<canvas id="hero-seascape-canvas" class="hero-seascape-canvas" aria-hidden="true"></canvas>

<style>
  .hero-seascape-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
  }
</style>

<script>
  const VERT_SRC = `
    attribute vec2 aPosition;
    void main() {
      gl_Position = vec4(aPosition, 0.0, 1.0);
    }
  `;

  const FRAG_SRC = `
    precision mediump float;

    uniform vec2 iResolution;
    uniform float iTime;

    const float gravity = 1.0;
    const float waterTension = 0.01;
    const vec3 seaCol1 = vec3(3.0, 30.0, 32.0) / 255.0;    // shadowed water — deep teal-green
    const vec3 seaCol2 = vec3(95.0, 225.0, 175.0) / 255.0; // lit highlights — green-leaning teal

    // Stand-in for sky/sun until those get added back deliberately — a
    // flat fog tone matched to the site's palette rather than the
    // original shader's procedural sky.
    const vec3 FOG_COLOR = vec3(6.0, 66.0, 74.0) / 255.0; // green-leaning mid-water
    const vec3 SUN_COLOR = vec3(0.85, 0.96, 1.0);

    // Cheap angular light-shaft falloff from a single screen-space source
    // point — no loop. Distance is normalized per-axis (divided by width
    // and height separately) rather than by one dimension alone, since
    // normalizing by only one dimension on a wide/short canvas stretches
    // the glow across the full width instead of keeping it a tight cone.
    // coneCos narrows the fan: raise it (closer to 1.0) for a tighter
    // beam around rayDir, lower it for a wider spread.
    float lightShaft(vec2 raySource, vec2 rayDir, vec2 coord, float freqA, float freqB, float speed, float t, float coneCos, float reach, float contrast, float floorAmt) {
      vec2 toCoord = coord - raySource;
      float cosAngle = dot(normalize(toCoord), rayDir);
      float shimmerA = 0.5 + 0.5 * sin(cosAngle * freqA + t * speed);
      float shimmerB = 0.5 + 0.5 * cos(-cosAngle * freqB + t * speed * 0.7);
      float pattern = pow(clamp(shimmerA * shimmerB, 0.0, 1.0), contrast);
      // floorAmt keeps this from ever going fully dark between peaks —
      // without it, the gaps read as separate black spotlight beams;
      // with it, it reads as one surface shimmering unevenly.
      pattern = mix(floorAmt, 1.0, pattern);
      vec2 normDist = toCoord / iResolution.xy;
      float falloff = clamp(1.0 - length(normDist) / reach, 0.0, 1.0);
      // coneCos is now a soft, wide gate rather than a hard narrow cutoff
      // — it only fades rays out well off to the sides, not across most
      // of the frame.
      float cone = smoothstep(coneCos, 1.0, cosAngle);
      return pattern * falloff * cone;
    }

    // Compact bright core right at the light source — this is what
    // actually reads as "there's a sun there" even before the beams do.
    float sunCore(vec2 raySource, vec2 coord, float sharpness) {
      vec2 d = (coord - raySource) / iResolution.xy;
      float dist = length(d);
      return exp(-dist * dist * sharpness);
    }

    // GLSL ES 1.00 (WebGL1) has no built-in tanh — WebGL2-only. Numerically
    // stable manual version: exp(-2|x|) never overflows, unlike computing
    // exp(2x) directly for large x.
    float tanhSafe(float x) {
      float e = exp(-2.0 * abs(x));
      float t = (1.0 - e) / (1.0 + e);
      return x < 0.0 ? -t : t;
    }

    float gravityWave(vec2 p, float k, float h, float t) {
      float w = sqrt(gravity * k * tanhSafe(k * h));
      return sin(p.y * k + w * t);
    }

    float capillaryWave(vec2 p, float k, float h, float t) {
      float w = sqrt((gravity * k + waterTension * k * k * k) * tanhSafe(k * h));
      return sin(p.y * k + w * t);
    }

    void rotWave(inout vec2 p, float a) {
      float c = cos(a);
      float s = sin(a);
      p = vec2(p.x * c + p.y * s, -p.x * s + p.y * c);
    }

    float seaHeight(vec2 p, float t) {
      float height = 0.0;
      float k = 1.0;
      float kk = 1.42;
      float a = 0.25;
      float aa = 1.0 / (kk * kk);
      float h = 10.0;
      p *= 0.5;
      for (int i = 0; i < 3; ++i) {
        height += a * gravityWave(p + float(i), k, h, t);
        rotWave(p, float(i));
        k *= kk;
        a *= aa;
      }
      for (int i = 3; i < 7; ++i) {
        height += a * capillaryWave(p + float(i), k, h, t);
        rotWave(p, float(i));
        k *= kk;
        a *= aa;
      }
      return height;
    }

    vec3 seaNormal(vec2 p, float d, float t) {
      vec2 eps = vec2(0.0006 * pow(d, 1.15), 0.0);
      vec3 n = vec3(
        seaHeight(p + eps, t) - seaHeight(p - eps, t),
        2.0 * eps.x,
        seaHeight(p + eps.yx, t) - seaHeight(p - eps.yx, t)
      );
      return normalize(n);
    }

    // Direction used for diffuse lighting only — no visible sun disc,
    // that's part of what's deferred until sky comes back. Y is negated
    // to match the mirrored (underwater-looking-up) normal convention
    // below.
    vec3 lightDirection() {
      return normalize(vec3(0.0, -0.15, 1.0));
    }

    void main() {
      vec2 q = gl_FragCoord.xy / iResolution.xy;
      vec2 p = -1.0 + 2.0 * q;
      p.x *= iResolution.x / iResolution.y;

      // Pan the view down slightly, which pushes the visible wave detail
      // higher in the frame (and partly off the top edge) instead of it
      // filling more of the screen. Raise this value for more push,
      // lower/negative to bring the waves back down into frame.
      const float VIEW_RAISE = 0.35;
      p.y -= VIEW_RAISE;

      // Camera below the plane looking up — mirrored from the original
      // above-the-plane framing, so the surface reads as being overhead.
      vec3 ro = vec3(0.0, -10.0, 0.0);
      vec3 ww = normalize(vec3(0.0, 0.1, 1.0));
      vec3 uu = normalize(cross(vec3(0.0, 1.0, 0.0), ww));
      vec3 vv = normalize(cross(ww, uu));
      vec3 rd = normalize(p.x * uu + p.y * vv + 2.5 * ww);

      float dsea = (0.0 - ro.y) / rd.y;
      vec3 sunDir = lightDirection();
      vec3 col;

      if (dsea > 0.0) {
        vec3 hitP = ro + dsea * rd;
        float h = seaHeight(hitP.xz, iTime);

        // The height-field normal always points "up" (away from the
        // water body) regardless of camera position. Since we're now
        // below the surface looking at its underside, flip the vertical
        // component so it faces back toward the camera — otherwise the
        // fresnel/diffuse dot products come out with the wrong sign and
        // everything reads flat.
        vec3 norRaw = seaNormal(hitP.xz, dsea, iTime);
        norRaw.y = -norRaw.y;
        vec3 nor = mix(norRaw, vec3(0.0, -1.0, 0.0), smoothstep(0.0, 200.0, dsea));

        float fre = clamp(1.0 - dot(-nor, rd), 0.0, 1.0);
        fre = pow(fre, 3.0);
        // Sharpened with an extra pow() beyond the mix, so lit facets
        // separate more clearly from shadowed ones — this is the base
        // shading contrast, independent of the specular glint.
        float difRaw = pow(max(dot(nor, sunDir), 0.0), 1.6);
        float dif = mix(0.05, 1.0, difRaw);

        vec3 refl = FOG_COLOR * 1.4; // placeholder "reflection" until sky/sun exist
        vec3 refr = seaCol1 + dif * seaCol2 * 0.4;

        col = mix(refr, 0.9 * refl, fre);

        // Two specular layers: the tight one's exponent came down from
        // 60 to 32 so it doesn't snap straight from dark to blown-out
        // with nothing graduated between — that hard jump was reading
        // as harsh/over-contrasted. The wide layer picks up more of the
        // weight now so the shine feels more like a soft dappled sparkle.
        vec3 reflDir = reflect(rd, nor);
        float specTight = pow(max(dot(reflDir, sunDir), 0.0), 32.0);
        float specWide = pow(max(dot(reflDir, sunDir), 0.0), 5.0);
        col += SUN_COLOR * specTight * 0.75;
        col += SUN_COLOR * specWide * 0.3;

        float atten = max(1.0 - dsea * dsea * 0.001, 0.0);
        col += seaCol2 * (hitP.y - h) * 2.0 * atten;

        col = mix(col, FOG_COLOR, 1.0 - exp(-0.01 * dsea));
      } else {
        col = FOG_COLOR;
      }

      // Light shafts from a source near the top of frame, shining "down"
      // through the water — applied over both the surface and the dark
      // fog below, which is what actually sells sunlight passing through
      // rather than just a surface highlight.
      // Source sits above the visible screen (y > iResolution.y, off the
      // top edge) rather than just near the top — this is what makes it
      // read as a distant sun rather than a light fixture in-frame. This
      // point is only used for the RAY FAN's angular math below.
      vec2 sunScreenPos = vec2(iResolution.x * 0.5, iResolution.y * 1.35);

      // The visible glow/core/color-ramp need their own ON-SCREEN anchor
      // — using the off-screen sunScreenPos for those meant the "hot"
      // core and the white center of the color ramp were both measuring
      // distance from a point too far away to ever actually appear on
      // canvas, so they were nearly invisible instead of a real spot.
      vec2 glowScreenPos = vec2(iResolution.x * 0.5, iResolution.y * 0.92);

      float shaft1 = lightShaft(sunScreenPos, normalize(vec2(0.0, -1.0)), gl_FragCoord.xy, 90.0, 50.0, 1.2, iTime, 0.8, 1.8, 1.4, 0.35);
      float shaft2 = lightShaft(sunScreenPos + vec2(iResolution.x * 0.02, 0.0), normalize(vec2(0.006, -1.0)), gl_FragCoord.xy, 120.0, 64.0, 0.9, iTime, 0.8, 1.8, 1.4, 0.35);
      float shaft3 = lightShaft(sunScreenPos - vec2(iResolution.x * 0.015, 0.0), normalize(vec2(-0.004, -1.0)), gl_FragCoord.xy, 145.0, 78.0, 1.0, iTime, 0.8, 1.8, 1.4, 0.35);
      float shaftGlow = shaft1 * 0.45 + shaft2 * 0.35 + shaft3 * 0.3;

      // Fade the beams in over roughly the top 20% of the frame instead
      // of starting at full brightness right at the edge — that hard
      // start is what made it look like a spotlight shining in from
      // off-screen rather than light already coming through the surface.
      float distFromTop = (iResolution.y - gl_FragCoord.y) / iResolution.y;
      float topFadeIn = smoothstep(0.0, 0.2, distFromTop);
      shaftGlow *= topFadeIn;

      // Two-tier core: a broad soft halo plus a small, much sharper hot
      // center inside it — one exp falloff alone reads as an even, soft
      // blob; stacking a tight one on top gives the small hard bright
      // spot from the reference instead.
      float coreHalo = sunCore(glowScreenPos, gl_FragCoord.xy, 8.0);
      float coreHot = sunCore(glowScreenPos, gl_FragCoord.xy, 45.0);

      col += SUN_COLOR * shaftGlow * 0.55;
      col += SUN_COLOR * coreHalo * 0.7;
      col += SUN_COLOR * coreHot * 1.6;

      // Radial color ramp around the light source: near-white at the
      // very center, through green, out to the blue base color — a
      // color transition, not just a brightness falloff, matching the
      // halo effect in the reference photo.
      vec2 haloDelta = (gl_FragCoord.xy - glowScreenPos) / iResolution.xy;
      float haloDist = length(haloDelta);
      vec3 haloWhite = vec3(0.98, 1.0, 0.95);
      vec3 haloGreen = vec3(0.55, 0.95, 0.6);
      vec3 haloTint = mix(haloWhite, haloGreen, smoothstep(0.0, 0.2, haloDist));
      float haloStrength = 1.0 - smoothstep(0.12, 0.6, haloDist);
      col = mix(col, haloTint, haloStrength * 0.55);

      // Soft-knee compression instead of hard clipping — keeps texture
      // visible in bright areas (the specular glint, the shafts) rather
      // than everything flattening out to solid white.
      col = col / (1.0 + col * 0.22);

      // Fade to transparent near the bottom edge so it blends into the
      // page's .ocean gradient behind it instead of ending in a hard
      // edge. gl_FragCoord.y is 0 at the BOTTOM of the viewport in WebGL.
      float screenY = 1.0 - (gl_FragCoord.y / iResolution.y);
      float alpha = 1.0 - smoothstep(0.7, 1.0, screenY);

      gl_FragColor = vec4(col, alpha);
    }
  `;

  function compileShader(gl: WebGLRenderingContext, type: number, source: string) {
    const shader = gl.createShader(type);
    if (!shader) return null;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.warn('HeroSeascape shader compile error:', gl.getShaderInfoLog(shader));
      gl.deleteShader(shader);
      return null;
    }
    return shader;
  }

  function setup() {
    const canvas = document.getElementById('hero-seascape-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: false });
    if (!gl) {
      canvas.style.display = 'none';
      return;
    }

    const vertShader = compileShader(gl, gl.VERTEX_SHADER, VERT_SRC);
    const fragShader = compileShader(gl, gl.FRAGMENT_SHADER, FRAG_SRC);
    if (!vertShader || !fragShader) {
      canvas.style.display = 'none';
      return;
    }

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vertShader);
    gl.attachShader(program, fragShader);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.warn('HeroSeascape program link error:', gl.getProgramInfoLog(program));
      canvas.style.display = 'none';
      return;
    }
    gl.useProgram(program);

    const positionBuffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPosition = gl.getAttribLocation(program, 'aPosition');
    gl.enableVertexAttribArray(aPosition);
    gl.vertexAttribPointer(aPosition, 2, gl.FLOAT, false, 0, 0);

    const uResolution = gl.getUniformLocation(program, 'iResolution');
    const uTime = gl.getUniformLocation(program, 'iTime');

    // Ray/plane intersection + a few octaves of sine per pixel — cheap
    // enough to run near full resolution.
    const RENDER_SCALE = 0.9;
    const MAX_DPR = 2.0;

    let width = 0;
    let height = 0;

    function resize() {
      if (!gl || !canvas) return;
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR) * RENDER_SCALE;
      width = Math.max(1, Math.floor(rect.width * dpr));
      height = Math.max(1, Math.floor(rect.height * dpr));
      canvas.width = width;
      canvas.height = height;
      gl.viewport(0, 0, width, height);
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let inView = true;
    let rafId = 0;

    function render(now: number) {
      if (!gl) return;
      const t = prefersReducedMotion ? 0 : now / 1000;
      gl.uniform2f(uResolution, width, height);
      gl.uniform1f(uTime, t);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      if (!prefersReducedMotion && inView && !document.hidden) {
        rafId = requestAnimationFrame(render);
      }
    }

    function start() {
      cancelAnimationFrame(rafId);
      if (prefersReducedMotion) {
        render(0); // single static frame, no loop
        return;
      }
      rafId = requestAnimationFrame(render);
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView) start();
        else cancelAnimationFrame(rafId);
      },
      { threshold: 0 }
    );
    observer.observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else if (inView) {
        start();
      }
    });

    window.addEventListener('resize', resize);
    resize();
    start();
  }

  setup();
</script>