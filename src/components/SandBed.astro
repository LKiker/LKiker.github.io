---
// SandBed.astro
// A container-scoped WebGL layer that renders a single STATIC frame of
// procedural sand — wavy ripple-line dunes + fine speckle grain + sparse
// mineral glints — meant to sit behind the footer, the visual "seabed"
// at the very end of the descent.
//
// The ripple-line noise technique (hash22/gradN2D/grad/sandL, in the
// script below) is adapted from a CC BY-NC-SA-style ShaderToy raymarched
// desert-sand shader — only the flat ripple-pattern generator was
// ported, dropped down to a single static layer with no raymarched
// terrain, camera path, sky, or mist. Keep that attribution comment
// intact in the script below, and credit the source again somewhere
// visible (footer/colophon) if you still have the original link.
//
// Unlike HeroSeascape/SunRays, there is NO requestAnimationFrame loop at
// all: the shader draws exactly once (on load, and again on resize), then
// sits idle. That's the whole point of "static" — zero ongoing cost, so
// it's safe to leave running behind the footer on every page.
//
// Usage: drop <SandBed /> as the FIRST child inside <footer> in
// Footer.astro (footer already has position: relative). Everything else
// in the footer (.footer-content, .copyright) needs z-index: 1+ to sit
// on top of it — the canvas itself defaults to z-index: 0.
---

<canvas id="sand-bed-canvas" class="sand-bed-canvas" aria-hidden="true"></canvas>

<style>
  .sand-bed-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const VERT_SRC = `
    attribute vec2 aPosition;
    void main() {
      gl_Position = vec4(aPosition, 0.0, 1.0);
    }
  `;

  const FRAG_SRC = `
    precision mediump float;

    uniform vec2 iResolution;
    uniform float uSeed;

    // --- sand ripple generation ---
    // The ripple-line technique below (hash22 → gradN2D → grad → sandL)
    // is adapted from a CC BY-NC-SA-style ShaderToy raymarched desert
    // shader. Only the flat sand-ripple pattern generator was ported —
    // the raymarched terrain, camera path, sky, and mist from the
    // original are not used here at all, since this renders one static
    // flat frame, not a 3D scene. If you still have the original
    // ShaderToy link, credit it here alongside the HeroSeascape credit.

    float hash(vec2 p) {
      p = fract(p * vec2(443.897, 441.423) + uSeed);
      p += dot(p, p.yx + 19.19);
      return fract((p.x + p.y) * p.x);
    }

    mat2 rot2(float a) {
      float c = cos(a);
      float s = sin(a);
      return mat2(c, s, -s, c);
    }

    // 2D hash returning a 2D vector, used as the gradient source below.
    // "Rigid" (non-animated) on purpose — this renders a single static
    // frame, so there's no time-based rotation like the original had.
    vec2 hash22(vec2 p) {
      p += uSeed;
      float n = sin(dot(p, vec2(113.0, 1.0)));
      return fract(vec2(2097152.0, 262144.0) * n) * 2.0 - 1.0;
    }

    // Gradient (Perlin-style) noise. Smoother and more "flowing" than
    // plain value noise, which is what lets the ripple lines below bend
    // and wander organically instead of looking like static blobs.
    float gradN2D(vec2 f) {
      const vec2 e = vec2(0.0, 1.0);
      vec2 p = floor(f);
      f -= p;
      vec2 w = f * f * (3.0 - 2.0 * f);
      float c = mix(
        mix(dot(hash22(p + e.xx), f - e.xx), dot(hash22(p + e.yx), f - e.yx), w.x),
        mix(dot(hash22(p + e.xy), f - e.xy), dot(hash22(p + e.yy), f - e.yy), w.x),
        w.y
      );
      return c * 0.5 + 0.5;
    }

    // Repeating triangle-wave gradient — this is what actually produces
    // individual ripple lines, rather than an undifferentiated noise
    // field. "offs" shifts the phase, used to offset two overlapping
    // line sets below.
    float grad(float x, float offs) {
      x = abs(fract(x / 6.283 + offs - 0.25) - 0.5) * 2.0;
      float x2 = clamp(x * x * (-1.0 + 2.0 * x), 0.0, 1.0);
      x = smoothstep(0.0, 1.0, x);
      return mix(x, x2, 0.15);
    }

    // One layer of sand ripples: two copies of the repeating line
    // gradient, rotated a few degrees apart and perturbed with gradient
    // noise so the lines read as wavy ripples rather than perfectly
    // straight bands, then screen-blended together using an underlying
    // rotated noise field so the two line sets interleave unevenly
    // instead of forming one uniform grid.
    float sandL(vec2 p) {
      vec2 q = rot2(3.14159 / 18.0) * p;
      q.y += (gradN2D(q * 18.0) - 0.5) * 0.05;
      float grad1 = grad(q.y * 80.0, 0.0);

      q = rot2(-3.14159 / 20.0) * p;
      q.y += (gradN2D(q * 12.0) - 0.5) * 0.05;
      float grad2 = grad(q.y * 80.0, 0.5);

      q = rot2(3.14159 / 4.0) * p;
      float a2 = dot(sin(q * 12.0 - cos(q.yx * 12.0)), vec2(0.25)) + 0.5;
      float a1 = 1.0 - a2;

      return 1.0 - (1.0 - grad1 * a1) * (1.0 - grad2 * a2);
    }

    // Two sandL layers at different rotation/scale, blended by a slower
    // underlying noise field — this breaks the ripple pattern up into
    // drifting patches instead of one uniform texture across the frame.
    float sandField(vec2 p) {
      p = vec2(p.y - p.x, p.x + p.y) * 0.7071 / 4.0;

      float c1 = sandL(p);
      vec2 q = rot2(3.14159 / 12.0) * p;
      float c2 = sandL(q * 1.25);

      return mix(c1, c2, smoothstep(0.1, 0.9, gradN2D(p * 4.0)));
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / iResolution.y;
      float aspect = iResolution.x / iResolution.y;

      // Fake perspective depth: uv.y = 0 (bottom of canvas) is treated as
      // nearest to the viewer, uv.y = 1 (top of canvas) as the horizon —
      // the same "camera height / screen row" relationship a raycasted
      // floor uses. Depth grows sharply as uv.y approaches 1, clamped so
      // it never actually reaches a divide-by-zero at the horizon line
      // itself.
      float depth = 1.0 / max(1.0 - uv.y, 0.035);

      // Perspective-correct world coordinates: a fixed horizontal pixel
      // distance covers far more world-space the further away it is — the
      // same reason parallel lines on a road converge toward a vanishing
      // point. Centering on the canvas's actual midpoint (via aspect)
      // rather than assuming uv.x is 0..1 keeps the convergence point
      // centered regardless of the footer's width. This is what makes
      // the ripple pattern compress and recede into the distance instead
      // of tiling at one uniform scale all the way up the frame —
      // mirroring how HeroSeascape's waves compress toward its horizon.
      float worldX = (uv.x - aspect * 0.5) * depth;
      vec2 worldP = vec2(worldX, depth) * 0.55; // overall ripple density — raise for finer ripples, lower for coarser

      float dunes = sandField(worldP);

      // How hazy/distant this row is, ramping up with depth. Used below
      // to wash out ripple contrast and blend toward a fog tone — without
      // this, the compressed ripples near the horizon would read as harsh
      // aliasing/moire instead of a soft fade into the distance.
      float fogAmount = smoothstep(2.0, 8.0, depth);
      float duneVal = mix(dunes, 0.5, fogAmount);

      // Sandy olive/tan palette pulled from a real seabed reference photo
      // (dark mossy-brown in the shadows, khaki mid-tone, pale sandy
      // highlight) instead of the site's blue-teal water tokens — this
      // layer reads as ground, not more water.
        vec3 sandDark  = vec3(24.0, 31.0, 41.0) / 255.0;
        vec3 sandMid   = vec3(46.0, 51.0, 56.0) / 255.0;
        vec3 sandLight = vec3(71.0, 73.0, 74.0) / 255.0;

      vec3 col = mix(sandDark, sandMid, duneVal);
      col = mix(col, sandLight, pow(duneVal, 4.0) * 0.3 * (1.0 - fogAmount));

      // Fine speckle grain gives the flat dune shading actual sand
      // texture instead of looking like a smooth gradient blob. Faded out
      // with distance too — fine sand grain wouldn't be resolvable from
      // far away in the first place.
      float grain = hash(gl_FragCoord.xy * 0.6);
      col += (grain - 0.5) * 0.035 * (1.0 - fogAmount);

      // Sparse mineral glints — a small fraction of grains catch a paler
      // highlight, like sand catching residual light. Also faded with
      // distance for the same reason as the grain above.
      float sparkle = step(0.9975, hash(floor(gl_FragCoord.xy * 0.5) + 100.0));
      col = mix(col, sandLight, sparkle * 0.5 * (1.0 - fogAmount));

      // Blend toward a hazy horizon tone (matching the .ocean gradient's
      // mid-water stop) as fog increases, so the sand visually dissolves
      // into distance haze before the alpha fade below removes it
      // entirely — two things working together instead of a single hard
      // cutoff doing all the work.
      vec3 fogColor = vec3(10.0, 63.0, 84.0) / 255.0;
      col = mix(col, fogColor, fogAmount * 0.6);

      // Fade the TOP edge of the canvas to transparent (gl_FragCoord.y
      // near iResolution.y, i.e. uv.y near 1 — the horizon in the depth
      // model above) so the sandbed dissolves into the .ocean gradient's
      // abyss stop above the footer instead of showing a hard seam.
      // Bottom of the canvas (uv.y near 0) stays fully opaque.
      float topFade = smoothstep(0.0, 0.25, 1.0 - uv.y);

      gl_FragColor = vec4(col, topFade);
    }
  `;

  function compileShader(gl: WebGLRenderingContext, type: number, source: string) {
    const shader = gl.createShader(type);
    if (!shader) return null;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.warn('SandBed shader compile error:', gl.getShaderInfoLog(shader));
      gl.deleteShader(shader);
      return null;
    }
    return shader;
  }

  function setup() {
    const canvas = document.getElementById('sand-bed-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: false });
    if (!gl) {
      // No WebGL support — footer just shows the plain .ocean background.
      canvas.style.display = 'none';
      return;
    }

    const vertShader = compileShader(gl, gl.VERTEX_SHADER, VERT_SRC);
    const fragShader = compileShader(gl, gl.FRAGMENT_SHADER, FRAG_SRC);
    if (!vertShader || !fragShader) {
      canvas.style.display = 'none';
      return;
    }

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vertShader);
    gl.attachShader(program, fragShader);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.warn('SandBed program link error:', gl.getProgramInfoLog(program));
      canvas.style.display = 'none';
      return;
    }
    gl.useProgram(program);

    const positionBuffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPosition = gl.getAttribLocation(program, 'aPosition');
    gl.enableVertexAttribArray(aPosition);
    gl.vertexAttribPointer(aPosition, 2, gl.FLOAT, false, 0, 0);

    const uResolution = gl.getUniformLocation(program, 'iResolution');
    const uSeed = gl.getUniformLocation(program, 'uSeed');

    // Fixed per-load seed so the pattern doesn't reroll on every resize —
    // it should look like one continuous seabed, not a new one each time.
    const seed = Math.random() * 1000.0;

    // No animation, so no need to spare the GPU with a tiny render scale —
    // but the grain/sparkle detail benefits from resolution, so keep this
    // closer to native than the animated shaders elsewhere on the site.
    const RENDER_SCALE = 0.75;
    const MAX_DPR = 1.5;

    let width = 0;
    let height = 0;

    function draw() {
      if (!gl) return;
      gl.uniform2f(uResolution, width, height);
      gl.uniform1f(uSeed, seed);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    function resize() {
      if (!gl || !canvas) return;
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR) * RENDER_SCALE;
      width = Math.max(1, Math.floor(rect.width * dpr));
      height = Math.max(1, Math.floor(rect.height * dpr));
      canvas.width = width;
      canvas.height = height;
      gl.viewport(0, 0, width, height);
      draw();
    }

    // Render once the footer is actually visible, rather than paying the
    // (small, one-time) cost while it's still off-screen below the fold.
    let hasRendered = false;
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          resize();
          observer.disconnect();
        }
      },
      { threshold: 0, rootMargin: '200% 0px' }
    );
    observer.observe(canvas);

    // Re-draw on resize (debounced to one draw per animation frame) —
    // still just a single static frame, never a running loop.
    let resizeScheduled = false;
    window.addEventListener('resize', () => {
      if (!hasRendered || resizeScheduled) return;
      resizeScheduled = true;
      requestAnimationFrame(() => {
        resize();
        resizeScheduled = false;
      });
    });
  }

  setup();
</script>