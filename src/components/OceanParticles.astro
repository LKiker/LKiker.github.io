---
// Ambient underwater particle layer only — no background gradient,
// assumes the page already has a background. Two particle types:
// tiny sparkle specks (uniform distribution) and a few soft
// out-of-focus bokeh circles (blurred, low opacity), matching
// natural suspended-particle / plankton photography.
// data-depth is kept for a later parallax script.

interface Particle {
  cx: number;
  cy: number;
  r: number;
  o: number;
}

function generateParticles(count: number, seed: number, minR: number, maxR: number, minO: number, maxO: number): Particle[] {
  const particles: Particle[] = [];
  let s = seed;
  const rand = () => {
    s = (s * 9301 + 49297) % 233280;
    return s / 233280;
  };
  for (let i = 0; i < count; i++) {
    particles.push({
      cx: rand() * 100,
      cy: rand() * 100,
      r: minR + rand() * (maxR - minR),
      o: minO + rand() * (maxO - minO),
    });
  }
  return particles;
}

// Sparkle specks: tiny, uniform spread, three depth layers for parallax
const farSpecks = generateParticles(70, 17, 0.15, 0.35, 0.3, 0.55);
const midSpecks = generateParticles(45, 42, 0.2, 0.45, 0.4, 0.65);
const nearSpecks = generateParticles(25, 99, 0.25, 0.55, 0.5, 0.8);

// Bokeh circles: few, large, soft, low opacity
const bokeh = generateParticles(6, 71, 3, 8, 0.12, 0.28);
---

<div class="ocean-particles" aria-hidden="true">
  <svg class="particle-layer" data-depth="0.1" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
    {farSpecks.map((p) => (
      <circle cx={p.cx} cy={p.cy} r={p.r} fill="#eafcff" opacity={p.o} />
    ))}
  </svg>

  <svg class="particle-layer" data-depth="0.3" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
    {midSpecks.map((p) => (
      <circle cx={p.cx} cy={p.cy} r={p.r} fill="#eafcff" opacity={p.o} />
    ))}
    <defs>
      <filter id="bokeh-blur" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="1.2" />
      </filter>
      <radialGradient id="bokeh-fill" cx="40%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#eafcff" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#eafcff" stop-opacity="0" />
      </radialGradient>
    </defs>
    {bokeh.map((p) => (
      <circle cx={p.cx} cy={p.cy} r={p.r} fill="url(#bokeh-fill)" opacity={p.o} filter="url(#bokeh-blur)" />
    ))}
  </svg>

  <svg class="particle-layer" data-depth="0.6" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
    {nearSpecks.map((p) => (
      <circle cx={p.cx} cy={p.cy} r={p.r} fill="#ffffff" opacity={p.o} />
    ))}
  </svg>
</div>

<style>
  .ocean-particles {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .particle-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>