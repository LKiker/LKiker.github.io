---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, eyebrow, description, tags, links, media } = project;
---

<article class="project-card" data-project-id={project.id} data-category={project.category}>
  <div class="media-frame">
    {media.video ? (
      <video
        class="project-video"
        poster={media.poster}
        muted
        loop
        playsinline
        preload="none"
      >
        <source src={media.video} type="video/mp4" />
      </video>
    ) : media.poster ? (
      <img class="project-poster" src={media.poster} alt={`${title} preview`} />
    ) : (
      <div class="media-placeholder" aria-hidden="true"></div>
    )}

    <div class="card-content">
      <p class="eyebrow">{eyebrow}</p>
      <h3 class="title">{title}</h3>
      <p class="description">{description}</p>

      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )}

      <div class="links">
        {links.github && (
          <a class="link" href={links.github} target="_blank" rel="noopener noreferrer">
            View on GitHub →
          </a>
        )}
        {links.live && (
          <a class="link" href={links.live} target="_blank" rel="noopener noreferrer">
            View live →
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
    .project-card {
        height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
        box-sizing: border-box;
    }

    .media-frame {
        position: relative;
        width: 100%;
        height: 100%;
        max-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 8px;
    }

    .project-video,
    .project-poster {
      width: 100%;
      height: 100%;
      object-fit: cover;

      --fade-inner: 55%;
      --fade-outer: 80%;

      -webkit-mask-image: radial-gradient(
        ellipse farthest-side at center,
        black var(--fade-inner),
        transparent var(--fade-outer)
      );
      mask-image: radial-gradient(
        ellipse farthest-side at center,
        black var(--fade-inner),
        transparent var(--fade-outer)
      );
    }

    .media-placeholder {
        width: 100%;
        height: 100%;
        background: #f0f0f0;
        border-radius: 8px;
    }

    .card-content {
        position: absolute;
        bottom: 1.5rem;
        right: 1.5rem;
        max-width: 380px;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.25rem 1.5rem;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(6px);
        color: #fff;
        border-radius: 8px;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0.5rem 0;
    }

    .tag {
        font-size: 0.8rem;
        padding: 0.25rem 0.6rem;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 999px;
    }

    .links {
        display: flex;
        gap: 1rem;
    }

    .link {
        color: #fff;
    }
</style>