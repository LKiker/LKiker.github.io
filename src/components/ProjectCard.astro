---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, tags, links, media } = project;

// Media area click target: same destination as the "View on GitHub" link
// next to it, falling back to the live link if there's no GitHub link.
const cardHref = links.github ?? links.live ?? null;

// Lets a gif-based card size its frame to the gif's own proportions
// instead of the fixed 80vh-capped box video/poster cards use — set as a
// custom property so plain CSS (no JS) can react to it via aspect-ratio.
const gifAspectRatio = media.gif ? `${media.gif.width} / ${media.gif.height}` : undefined;
---

<article class="project-card" data-project-id={project.id} data-category={project.category} data-lag="0.5">
  <div
    class="media-frame"
    data-parallax-depth="0.15"
    data-href={cardHref ?? undefined}
    data-has-gif={media.gif ? 'true' : undefined}
    style={gifAspectRatio ? `--gif-aspect-ratio: ${gifAspectRatio};` : undefined}
    role={cardHref ? 'link' : undefined}
    tabindex={cardHref ? 0 : undefined}
    aria-label={cardHref ? `${title} — open project link` : undefined}
  >
    <div class="push-anchor">
      <div class="media-visual">
        {media.video ? (
          <video
            class="project-video"
            poster={media.poster}
            muted
            loop
            playsinline
            preload="none"
          >
            <source src={media.video} type="video/mp4" />
          </video>
        ) : media.gif ? (
          <>
            <img
              class="project-gif"
              src={media.gif.src}
              width={media.gif.width}
              height={media.gif.height}
              alt={`${title} preview`}
            />
            {/* GIFs can't be paused via an element attribute the way <video>
                can, so if a still poster is available, swap to it under
                prefers-reduced-motion instead of leaving the animation
                running regardless of that preference. */}
            {media.poster && (
              <img
                class="project-poster project-gif-fallback"
                src={media.poster}
                alt={`${title} preview`}
              />
            )}
          </>
        ) : media.poster ? (
          <img class="project-poster" src={media.poster} alt={`${title} preview`} />
        ) : (
          <div class="media-placeholder" aria-hidden="true"></div>
        )}
        <div class="card-veil"></div>
      </div>
    </div>
  </div>

  <div class="card-content">
    <h3 class="title">{title}</h3>
    <p class="description">{description}</p>

    {tags.length > 0 && (
      <div class="tools-section">
        <span class="tools-label">Built with</span>
        <ul class="tags">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      </div>
    )}

    <div class="links">
      {links.github && (
        <a class="link" href={links.github} target="_blank" rel="noopener noreferrer">
          View on GitHub →
        </a>
      )}
      {links.live && (
        <a class="link" href={links.live} target="_blank" rel="noopener noreferrer">
          View live →
        </a>
      )}
    </div>
  </div>
</article>

<style>
    .project-card {
        height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        padding: 3rem 2rem;
        box-sizing: border-box;
        margin-bottom: 30vh;
        margin-top: 0vh;
        position: relative;
        z-index: 1;
    }

    /* Odd cards: media on the left, caption fills the space to the right.
       Even cards: mirrored. Real flex layout, not a visual illusion, so
       card-content genuinely occupies the room media-frame leaves open. */
    .project-card:nth-of-type(odd) {
        flex-direction: row;
    }

    .project-card:nth-of-type(even) {
        flex-direction: row-reverse;
    }

    .project-video,
    .project-poster,
    .project-gif {
          width: 100%;
          height: 100%;
          object-fit: cover;
    }

    /* Hidden by default; only shown in place of the animated gif when the
       user prefers reduced motion (see prefers-reduced-motion block below). */
    .project-gif-fallback {
        display: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .project-gif {
            display: none;
        }

        .project-gif-fallback {
            display: block;
        }
    }

    .media-frame {
        position: relative;
        flex: 0 1 60%;
        height: 80%;
        max-height: 80vh;
        transform: scale(0.92);
        transition: transform 0.8s ease;
    }

    /* Gif cards: derive height from width via the gif's own aspect ratio
       (set inline as --gif-aspect-ratio) rather than the fixed 80%/80vh
       box above, so the frame matches what's actually playing instead of
       cropping it via object-fit. max-height stays on as a clamp for
       unusually tall (portrait) gifs — past that point the image will
       letterbox/crop slightly rather than blowing out the row's height. */
    .media-frame[data-has-gif] {
        height: auto;
        aspect-ratio: var(--gif-aspect-ratio);
    }

    /* Clickable affordance — only when the card actually has a link to go
       to (data-href present). Focus-visible ring for keyboard users since
       this is a div acting as a link (role="link"/tabindex added inline). */
    .media-frame[data-href] {
        cursor: pointer;
    }

    .media-frame[data-href]:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
    }

    /* Pure CSS hover — deliberately not GSAP. Nothing else ever writes to
       .media-frame's transform (GSAP only touches .push-anchor's and
       .media-visual's), so this has zero competition and no merge-order
       dependency. Gated the same way the JS tilt effect is, so touch/
       no-hover devices simply keep the resting scale with no dead hover
       state to trip over. */
    @media (hover: hover) and (pointer: fine) {
        .media-frame:hover {
            transform: scale(0.96);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .media-frame {
            transition: none;
        }
    }

    /* Owns ONLY the pointer-driven push translation (x/y). Kept separate
       from .media-visual (which owns rotation/rotationX/rotationY from the
       floating idle tween + tilt) so no two GSAP tweens ever fight over
       the same transform properties on the same element. */
    .push-anchor {
      position: relative;
      width: 100%;
      height: 100%;
      /* Required so .media-frame's perspective still reaches .media-visual's
         rotationX/rotationY — without this, this element's own transform
         (the push translation) creates a flat 2D boundary that blocks the
         3D context from passing through to its child. */
      transform-style: preserve-3d;
    }

    .media-visual {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      border-radius: 8px;
    }

    .card-veil {
      position: absolute;
      inset: 0;
      background: var(--color-shallow);
      opacity: 0;
      mix-blend-mode: multiply;
      pointer-events: none;
      z-index: 2;
    }

    .media-placeholder {
        width: 100%;
        height: 100%;
        background: #f0f0f0;
    }

    /* Sibling of media-frame, not overlaid on top of it — sits in the
       flex space media-frame leaves open beside it. */
    .card-content {
        flex: 1 1 260px;
        max-width: 380px;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.25rem 1.5rem;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(6px);
        color: #fff;
        border-radius: 8px;
    }

    .tools-section {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin: 0.5rem 0;
    }

    .tools-label {
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        opacity: 0.6;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .tag {
        font-size: 0.8rem;
        padding: 0.25rem 0.6rem;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 999px;
    }

    .links {
        display: flex;
        gap: 1rem;
    }

    .link {
        color: #fff;
    }

    @media (max-width: 800px) {
        /* Stacked layout doesn't need the desktop's 30vh scroll buffer
           between cards or a hard-locked 100vh — let the card size to
           its actual content (gif/media + caption stacked) and just set
           a floor so short cards still get a full-screen "arrival" feel. */
        .project-card:nth-of-type(odd),
        .project-card:nth-of-type(even) {
            flex-direction: column;
            height: auto;
            min-height: 100vh;
            gap: 1.25rem;
            padding: 4rem 1.25rem;
            margin-bottom: 8rem;
        }

        .media-frame {
            flex: 0 1 auto;
            width: 100%;
            /* Desktop's height: 80%/max-height: 80vh (set on the base
               .media-frame rule) assumed a fixed-height row with content
               beside it, not above/below — on a narrow column that would
               eat most of the card and leave the caption crushed into a
               sliver underneath. Let height come from content instead. */
            height: auto;
            max-height: none;
        }

        /* Gif cards already get their own aspect-ratio from
           --gif-aspect-ratio (see .media-frame[data-has-gif] above) at
           any breakpoint, so this only needs to give video/poster cards
           — which have no intrinsic ratio to size by — a sane fallback
           box instead of an unbounded one. */
        .media-frame:not([data-has-gif]) {
            aspect-ratio: 16 / 9;
        }

        .card-content {
            /* Base rule's flex: 1 1 260px was written for the desktop row
               layout, where flex-grow fills leftover *width*. In this
               column layout the main axis is vertical, so that same
               flex-grow: 1 was stretching the box to fill leftover
               *height* inside the card's min-height: 100vh — hence the
               dead space under the text. flex-grow: 0 lets it size to
               its own content instead. */
            flex: 0 1 auto;
            max-width: none;
            width: 100%;
        }
    }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>('.media-visual').forEach((visual) => {
    const x = gsap.utils.random(-50, 50);
    const y = gsap.utils.random(-20, 20);
    const veil = visual.querySelector<HTMLElement>('.card-veil');

    // suspended/floating in water effect
    gsap.fromTo(
      visual,
      { rotation: -0.4 },
      {
        rotation: 0.4,
        x,
        y,
        transformOrigin: 'center center',
        duration: 2.3,
        ease: 'sine.inOut',
        scrollTrigger: visual,
        toggleActions: 'restart pause none none',
        repeat: -1,
        yoyo: true,
      }
    );

    // depth effect: card is clearest/sharpest centered in viewport,
    // blurs and dims toward the top/bottom edges of its scroll range
    // clear as it rises from bottom to center
    gsap.fromTo(
      visual,
      { filter: 'blur(6px) saturate(0.5) brightness(0.8)' },
      {
        filter: 'blur(0px) saturate(1) brightness(1)',
        ease: 'none',
        scrollTrigger: {
          trigger: visual,
          start: 'top bottom',
          end: '80% bottom',
          scrub: true,
        },
      }
    );

    // blurs again as it continues past center toward the top
    gsap.fromTo(
      visual,
      { filter: 'blur(0px) saturate(1) brightness(1)' },
      {
        filter: 'blur(6px) saturate(0.5) brightness(0.8)',
        ease: 'none',
        scrollTrigger: {
          trigger: visual,
          start: '20% top',
          end: 'bottom top',
          scrub: true,
        },
      }
    );

    // veil tints in/out on the same schedule as the blur
    if (veil) {
      gsap.fromTo(
        veil,
        { opacity: 0.75 },
        {
          opacity: 0,
          ease: 'none',
          scrollTrigger: {
            trigger: visual,
            start: 'top bottom',
            end: '80% bottom',
            scrub: true,
          },
        }
      );

      gsap.fromTo(
        veil,
        { opacity: 0 },
        {
          opacity: 0.75,
          ease: 'none',
          scrollTrigger: {
            trigger: visual,
            start: '20% top',
            end: 'bottom top',
            scrub: true,
          },
        }
      );
    }

    // Caption starts invisible. It only fades in once the card has been
    // substantially in view for a sustained 2 seconds — a real timer, not
    // tied to scroll position, so quickly scrolling past doesn't trigger
    // it. Fading OUT, though, mirrors the exact same scroll-scrubbed
    // schedule the veil re-tints on (20% top → bottom top), so the
    // caption disappears in lockstep with the rest of the card blurring
    // back out, rather than on its own timer.
    const cardContent = visual.closest<HTMLElement>('.project-card')?.querySelector<HTMLElement>('.card-content');
    if (cardContent) {
      gsap.set(cardContent, { opacity: 0 });

      let revealTimeout: ReturnType<typeof setTimeout> | undefined;

      const clearRevealTimer = () => {
        if (revealTimeout) {
          clearTimeout(revealTimeout);
          revealTimeout = undefined;
        }
      };

      // Entrance: wait 2s of continuous "in view" before fading in.
      ScrollTrigger.create({
        trigger: visual,
        start: 'top 85%',
        end: 'bottom 15%',
        onEnter: () => {
          clearRevealTimer();
          revealTimeout = setTimeout(() => {
            gsap.to(cardContent, { opacity: 1, duration: 1, ease: 'power2.out', overwrite: 'auto' });
          }, 1000);
        },
        onEnterBack: () => {
          clearRevealTimer();
          revealTimeout = setTimeout(() => {
            gsap.to(cardContent, { opacity: 1, duration: 1, ease: 'power2.out', overwrite: 'auto' });
          }, 1000);
        },
        onLeave: () => clearRevealTimer(),
        onLeaveBack: () => clearRevealTimer(),
      });

      // Exit: scroll-scrubbed, matching the veil's own re-tint window
      // exactly, so the caption vanishes in sync with the media blurring
      // back out. This is deliberately NOT a gsap.fromTo() tween — a
      // fromTo's "from" value gets rendered as soon as scroll progress is
      // 0, which is true for the ENTIRE time before the card reaches this
      // zone (i.e. the whole time it's sitting in view). That was
      // silently forcing opacity back to 1 the instant this was created,
      // overriding the 2s timer entirely — which is why the caption was
      // showing up immediately instead of waiting. Driving it manually in
      // onUpdate, gated by self.isActive, means this only ever touches
      // opacity while genuinely between start and end; outside that
      // window it leaves the property alone so the timer stays in
      // control.
      ScrollTrigger.create({
        trigger: visual,
        start: '20% top',
        end: 'bottom top',
        scrub: true,
        onUpdate: (self) => {
          if (self.isActive) {
            gsap.set(cardContent, { opacity: 1 - self.progress });
          }
        },
        onLeave: () => gsap.set(cardContent, { opacity: 0 }),
      });
    }
  });

  // Media-frame click-through: same destination as the card's "View on
  // GitHub" (or "View live") link. Reads data-href set server-side from
  // links.github ?? links.live, so there's a single source of truth for
  // the destination rather than duplicating link logic in JS.
  gsap.utils.toArray<HTMLElement>('.media-frame[data-href]').forEach((frame) => {
    const href = frame.dataset.href;
    if (!href) return;

    const openLink = () => {
      window.open(href, '_blank', 'noopener,noreferrer');
    };

    frame.addEventListener('click', openLink);

    frame.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLink();
      }
    });
  });

  // Pointer tilt + water-push
  const supportsHoverTilt = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const tiltReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (supportsHoverTilt && !tiltReducedMotion) {
    const TILT_MAX = 4; // deg, hard clamp — tilt can never exceed this in either direction
    const PUSH_MAX = 70; // px, hard clamp — push can never exceed this in either direction

    const TILT_EXTEND = 70; // px beyond the frame's actual edge where the tilt/content "which direction" reading still keeps sharpening, instead of maxing out right at the boundary
    const APPROACH_BUFFER = 280; // px beyond the frame's edge where the whole field (tilt + push) fades to nothing

    const CONTENT_APPROACH_DURATION = 0.5;
    const CONTENT_RETURN_DURATION = 1.3;

    // How fast the accumulators climb toward TILT_MAX / PUSH_MAX per
    // second of continuous full-strength approach — e.g. TILT_MAX / 0.8
    // means it takes ~0.8s of holding the cursor right at the object to
    // reach full tilt. Still noticeably softer than an instant snap,
    // but fast enough to register on a normal hover. Lower the divisor
    // (e.g. / 0.4) for snappier, raise it (e.g. / 2) for softer.
    const TILT_APPROACH_RATE_PER_SEC = TILT_MAX / 0.8;
    const PUSH_APPROACH_RATE_PER_SEC = PUSH_MAX / 0.8;

    // How much of the current tilt/push value survives each second while
    // retreating — 0.15 means ~15% remains after 1s (a fast-ish decay);
    // closer to 1 = slower, more lingering drift back to neutral.
    const TILT_RETURN_DECAY_PER_SEC = 0.2;
    const PUSH_RETURN_DECAY_PER_SEC = 0.28;

    // How much strength must change, frame to frame, before the
    // approach/retreat DIRECTION is allowed to flip. Without this, tiny
    // pointer jitter (a fraction of a pixel) made `strength` wobble up
    // and down, which flipped which quickTo pair (approach vs. return —
    // different durations/easing) was driving the content box every
    // single frame, producing a visible shake. Below this threshold the
    // previous direction is kept as-is.
    const STRENGTH_HYSTERESIS = 0.015;

    // A single shared pointer position, updated by ONE window listener
    // instead of one per card. With N cards the old version registered
    // N pointermove listeners AND called getBoundingClientRect() N times
    // on every single mouse move — this reads the pointer position once,
    // regardless of how many project cards exist on the page.
    let pointerX = 0;
    let pointerY = 0;
    let hasPointer = false;

    window.addEventListener(
      'pointermove',
      (e: PointerEvent) => {
        pointerX = e.clientX;
        pointerY = e.clientY;
        hasPointer = true;
      },
      { passive: true }
    );

    interface TiltCard {
      frame: HTMLElement;
      rect: DOMRect;
      inView: boolean;
      previousStrength: number;
      approachDirection: boolean;
      tiltRotationX: number;
      tiltRotationY: number;
      pushOffsetX: number;
      pushOffsetY: number;
      setRotationX: (v: number) => void;
      setRotationY: (v: number) => void;
      setPushX: ((v: number) => void) | null;
      setPushY: ((v: number) => void) | null;
      contentApproachX: ((v: number) => void) | null;
      contentApproachY: ((v: number) => void) | null;
      contentReturnX: ((v: number) => void) | null;
      contentReturnY: ((v: number) => void) | null;
    }

    const cards: TiltCard[] = [];

    gsap.utils.toArray<HTMLElement>('.media-frame').forEach((frame) => {
      gsap.set(frame, { perspective: 650 });

      const visual = frame.querySelector<HTMLElement>('.media-visual');
      const pushAnchor = frame.querySelector<HTMLElement>('.push-anchor');
      const content = frame.parentElement?.querySelector<HTMLElement>('.card-content') ?? null;
      if (!visual) return;

      // gsap.quickSetter's return type is typed as the generic `Function`
      // in GSAP's own .d.ts, which TS won't structurally match against
      // `(v: number) => void` — cast at the call site rather than
      // loosening TiltCard's field types.
      const setRotationX = gsap.quickSetter(visual, 'rotationX', 'deg') as (v: number) => void;
      const setRotationY = gsap.quickSetter(visual, 'rotationY', 'deg') as (v: number) => void;
      const setPushX = pushAnchor ? (gsap.quickSetter(pushAnchor, 'x', 'px') as (v: number) => void) : null;
      const setPushY = pushAnchor ? (gsap.quickSetter(pushAnchor, 'y', 'px') as (v: number) => void) : null;

      // One quickTo pair per direction (approach/return) since each
      // needs its own duration/ease — reused every frame instead of a
      // fresh gsap.to() tween getting created on every pointer reading.
      // overwrite: 'auto' matters here specifically because approach and
      // return are TWO SEPARATE tweens both targeting the same x/y
      // properties — without it, switching from one to the other can
      // leave both briefly active and writing conflicting values to the
      // same property in the same frame, which reads as a shake.
      // Cast for the same reason as the quickSetters above: GSAP's own
      // typings return a generic `Function`, which TS won't structurally
      // match against `(v: number) => void`.
      const contentApproachX = content ? (gsap.quickTo(content, 'x', { duration: CONTENT_APPROACH_DURATION, ease: 'power3', overwrite: 'auto' }) as (v: number) => void) : null;
      const contentApproachY = content ? (gsap.quickTo(content, 'y', { duration: CONTENT_APPROACH_DURATION, ease: 'power3', overwrite: 'auto' }) as (v: number) => void) : null;
      const contentReturnX = content ? (gsap.quickTo(content, 'x', { duration: CONTENT_RETURN_DURATION, ease: 'power2.out', overwrite: 'auto' }) as (v: number) => void) : null;
      const contentReturnY = content ? (gsap.quickTo(content, 'y', { duration: CONTENT_RETURN_DURATION, ease: 'power2.out', overwrite: 'auto' }) as (v: number) => void) : null;

      cards.push({
        frame,
        rect: frame.getBoundingClientRect(),
        inView: false,
        previousStrength: 0,
        approachDirection: false,
        tiltRotationX: 0,
        tiltRotationY: 0,
        pushOffsetX: 0,
        pushOffsetY: 0,
        setRotationX,
        setRotationY,
        setPushX,
        setPushY,
        contentApproachX,
        contentApproachY,
        contentReturnX,
        contentReturnY,
      });
    });

    // Rects only need refreshing when layout could actually have shifted
    // a card's position — on scroll or resize — not on every pointermove
    // and not every single animation frame regardless of activity.
    let rectRefreshScheduled = false;
    function refreshRects() {
      for (const card of cards) {
        card.rect = card.frame.getBoundingClientRect();
      }
      rectRefreshScheduled = false;
    }
    function scheduleRectRefresh() {
      if (rectRefreshScheduled) return;
      rectRefreshScheduled = true;
      requestAnimationFrame(refreshRects);
    }

    window.addEventListener('scroll', scheduleRectRefresh, { passive: true });
    window.addEventListener('resize', scheduleRectRefresh, { passive: true });

    // Cards well outside the viewport skip all tilt math entirely — no
    // reason to keep computing pointer distance for a card scrolled far
    // out of reach. rootMargin extends the "in view" zone past the
    // literal viewport edge so the effect is already primed by the time
    // a card scrolls into APPROACH_BUFFER range of the cursor.
    const visibilityObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const card = cards.find((c) => c.frame === entry.target);
          if (card) card.inView = entry.isIntersecting;
        }
      },
      { rootMargin: `${APPROACH_BUFFER}px` }
    );
    cards.forEach((card) => visibilityObserver.observe(card.frame));

    // ONE ticker callback shared across every card, instead of one per
    // card — and each card's math only runs at all when it's in view.
    gsap.ticker.add(() => {
      if (!hasPointer) return;
      const dt = gsap.ticker.deltaRatio(60) / 60; // seconds elapsed this tick, frame-rate independent

      for (const card of cards) {
        if (!card.inView) continue;

        const rect = card.rect;
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const halfWidth = rect.width / 2;
        const halfHeight = rect.height / 2;
        const dx = pointerX - centerX;
        const dy = pointerY - centerY;

        const closestX = gsap.utils.clamp(rect.left, rect.right, pointerX);
        const closestY = gsap.utils.clamp(rect.top, rect.bottom, pointerY);
        const edgeDx = pointerX - closestX;
        const edgeDy = pointerY - closestY;
        const edgeDistance = Math.sqrt(edgeDx * edgeDx + edgeDy * edgeDy);
        const strength = gsap.utils.clamp(0, 1, 1 - edgeDistance / APPROACH_BUFFER);

        // Direction only flips when the strength change clears the
        // hysteresis band — small pointer noise just keeps whatever
        // direction was already active, instead of thrashing between
        // the approach/return quickTo pairs every frame.
        if (strength > card.previousStrength + STRENGTH_HYSTERESIS) {
          card.approachDirection = true;
        } else if (strength < card.previousStrength - STRENGTH_HYSTERESIS) {
          card.approachDirection = false;
        }
        const approaching = card.approachDirection;
        card.previousStrength = strength;
        const isApproaching = approaching && strength > 0.001;

        const pushNormX = gsap.utils.clamp(-1, 1, dx / halfWidth);
        const pushNormY = gsap.utils.clamp(-1, 1, dy / halfHeight);
        const tiltNormX = gsap.utils.clamp(-1, 1, dx / (halfWidth + TILT_EXTEND));
        const tiltNormY = gsap.utils.clamp(-1, 1, dy / (halfHeight + TILT_EXTEND));

        // Content always tracks the cursor directly (or returns to 0),
        // approach or return, via whichever quickTo pair matches the
        // current direction.
        if (strength <= 0.001) {
          const setX = approaching ? card.contentApproachX : card.contentReturnX;
          const setY = approaching ? card.contentApproachY : card.contentReturnY;
          setX?.(0);
          setY?.(0);
        } else if (approaching) {
          card.contentApproachX?.(6 * tiltNormX * strength);
          card.contentApproachY?.(6 * tiltNormY * strength);
        } else {
          card.contentReturnX?.(6 * tiltNormX * strength);
          card.contentReturnY?.(6 * tiltNormY * strength);
        }

        // Tilt and push are accumulators, not absolute targets — nudged
        // gradually toward their max in the "away from cursor" direction
        // rather than computing a fresh target from scratch each time.
        // Applied to the DOM via quickSetter below, so both the approach
        // ramp and the return decay run smoothly over real time.
        if (isApproaching) {
          card.tiltRotationX = gsap.utils.clamp(-TILT_MAX, TILT_MAX, card.tiltRotationX + -tiltNormY * strength * TILT_APPROACH_RATE_PER_SEC * dt);
          card.tiltRotationY = gsap.utils.clamp(-TILT_MAX, TILT_MAX, card.tiltRotationY + tiltNormX * strength * TILT_APPROACH_RATE_PER_SEC * dt);
          card.pushOffsetX = gsap.utils.clamp(-PUSH_MAX, PUSH_MAX, card.pushOffsetX + -pushNormX * strength * PUSH_APPROACH_RATE_PER_SEC * dt);
          card.pushOffsetY = gsap.utils.clamp(-PUSH_MAX, PUSH_MAX, card.pushOffsetY + -pushNormY * strength * PUSH_APPROACH_RATE_PER_SEC * dt);
        } else {
          const tiltDecay = Math.pow(TILT_RETURN_DECAY_PER_SEC, dt);
          const pushDecay = Math.pow(PUSH_RETURN_DECAY_PER_SEC, dt);

          card.tiltRotationX *= tiltDecay;
          card.tiltRotationY *= tiltDecay;
          card.pushOffsetX *= pushDecay;
          card.pushOffsetY *= pushDecay;

          // Snap tiny residual values to exactly 0 so it fully settles
          // instead of decaying asymptotically forever.
          if (Math.abs(card.tiltRotationX) < 0.001) card.tiltRotationX = 0;
          if (Math.abs(card.tiltRotationY) < 0.001) card.tiltRotationY = 0;
          if (Math.abs(card.pushOffsetX) < 0.05) card.pushOffsetX = 0;
          if (Math.abs(card.pushOffsetY) < 0.05) card.pushOffsetY = 0;
        }

        card.setRotationX(card.tiltRotationX);
        card.setRotationY(card.tiltRotationY);
        card.setPushX?.(card.pushOffsetX);
        card.setPushY?.(card.pushOffsetY);
      }
    });
  }
</script>