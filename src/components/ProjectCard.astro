---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, tags, links, media } = project;
---


<article class="project-card" data-project-id={project.id} data-category={project.category}>
    <div class="media-frame" data-parallax-depth="0.15">
      <div class="media-visual">
        {media.video ? (
          <video
            class="project-video"
            poster={media.poster}
            muted
            loop
            playsinline
            preload="none"
          >
            <source src={media.video} type="video/mp4" />
            </video>
            ) : media.poster ? (
              <img class="project-poster" src={media.poster} alt={`${title} preview`} />
            ) : (
              <div class="media-placeholder" aria-hidden="true"></div>
            )}
        <div class="card-veil"></div>
      </div>

    <div class="card-content">
      <h3 class="title">{title}</h3>
      <p class="description">{description}</p>

      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )}

      <div class="links">
        {links.github && (
          <a class="link" href={links.github} target="_blank" rel="noopener noreferrer">
            View on GitHub →
          </a>
        )}
        {links.live && (
          <a class="link" href={links.live} target="_blank" rel="noopener noreferrer">
            View live →
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
    .project-card {
        height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
        box-sizing: border-box;
        margin-bottom: 70vh;
        margin-top: 20vh;
    }

    .project-video,
    .project-poster {
          width: 100%;
          height: 100%;
          object-fit: cover;
    }

    .media-frame {
        position: relative;
        width: 100%;
        height: 100%;
        max-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .media-visual {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      border-radius: 8px;
    }

    .card-veil {
      position: absolute;
      inset: 0;
      background: var(--color-shallow);
      opacity: 0;
      mix-blend-mode: multiply;
      pointer-events: none;
      z-index: 1;
    }

    .media-placeholder {
        width: 100%;
        height: 100%;
        background: #f0f0f0;
    }

    .card-content {
        position: absolute;
        bottom: 1.5rem;
        right: 1.5rem;
        max-width: 380px;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.25rem 1.5rem;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(6px);
        color: #fff;
        border-radius: 8px;
        z-index: 2;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0.5rem 0;
    }

    .tag {
        font-size: 0.8rem;
        padding: 0.25rem 0.6rem;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 999px;
    }

    .links {
        display: flex;
        gap: 1rem;
    }

    .link {
        color: #fff;
    }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);

  // scroll trigger for each card
  gsap.utils.toArray<HTMLElement>('.media-visual').forEach((visual) => {
    const x = gsap.utils.random(-10, 10);
    const y = gsap.utils.random(-10, 10);
    const veil = visual.querySelector<HTMLElement>('.card-veil');

    // suspended/floating in water effect
    gsap.fromTo(
      visual,
      { rotation: -0.4 },
      {
        rotation: 0.4,
        x,
        y,
        transformOrigin: 'center center',
        duration: gsap.utils.random(2, 3),
        ease: 'sine.inOut',
        scrollTrigger: visual,
        toggleActions: 'restart pause none none',
        repeat: -1,
        yoyo: true,
      }
    );

    // depth effect: card is clearest/sharpest centered in viewport,
    // blurs and dims toward the top/bottom edges of its scroll range
    // clear as it rises from bottom to center
    gsap.fromTo(
      visual,
      { filter: 'blur(6px) saturate(0.5) brightness(0.8)' },
      {
        filter: 'blur(0px) saturate(1) brightness(1)',
        ease: "none",
        scrollTrigger: {
          trigger: visual,
          start: 'top bottom',
          end: 'bottom bottom',
          scrub: true,
        },
      }
    );

    // blurs again as it continues past center toward the top
    gsap.fromTo(
      visual,
      { filter: 'blur(0px) saturate(1) brightness(1)' },
      {
        filter: 'blur(6px) saturate(0.5) brightness(0.8)',
        ease: "none",
        scrollTrigger: {
          trigger: visual,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      }
    );

    // veil tints in/out on the same schedule as the blur
    if (veil) {
      gsap.fromTo(
        veil,
        { opacity: 0.75 },
        {
          opacity: 0,
          ease: 'none',
          scrollTrigger: {
            trigger: visual,
            start: 'top bottom',
            end: 'bottom bottom',
            scrub: true,
          },
        }
      );

      gsap.fromTo(
        veil,
        { opacity: 0 },
        {
          opacity: 0.75,
          ease: 'none',
          scrollTrigger: {
            trigger: visual,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        }
      );
    }
  });
</script>