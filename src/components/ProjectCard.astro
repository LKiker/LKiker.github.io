---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, tags, links, media } = project;

// Media area click target: same destination as the "View on GitHub" link
// next to it, falling back to the live link if there's no GitHub link.
const cardHref = links.github ?? links.live ?? null;

// Lets a gif-based card size its frame to the gif's own proportions
// instead of the fixed 80vh-capped box video/poster cards use — set as a
// custom property so plain CSS (no JS) can react to it via aspect-ratio.
const gifAspectRatio = media.gif ? `${media.gif.width} / ${media.gif.height}` : undefined;
---

<article class="project-card" data-project-id={project.id} data-category={project.category} data-lag="0.5">
  <div
    class="media-frame"
    data-parallax-depth="0.15"
    data-href={cardHref ?? undefined}
    data-has-gif={media.gif ? 'true' : undefined}
    style={gifAspectRatio ? `--gif-aspect-ratio: ${gifAspectRatio};` : undefined}
    role={cardHref ? 'link' : undefined}
    tabindex={cardHref ? 0 : undefined}
    aria-label={cardHref ? `${title} — open project link` : undefined}
  >
    <div class="push-anchor">
      <div class="media-visual">
        {media.video ? (
          <video
            class="project-video"
            poster={media.poster}
            muted
            loop
            playsinline
            preload="none"
          >
            <source src={media.video} type="video/mp4" />
          </video>
        ) : media.gif ? (
          <>
            <img
              class="project-gif"
              src={media.gif.src}
              width={media.gif.width}
              height={media.gif.height}
              alt={`${title} preview`}
            />
            {/* GIFs can't be paused via an element attribute the way <video>
                can, so if a still poster is available, swap to it under
                prefers-reduced-motion instead of leaving the animation
                running regardless of that preference. */}
            {media.poster && (
              <img
                class="project-poster project-gif-fallback"
                src={media.poster}
                alt={`${title} preview`}
              />
            )}
          </>
        ) : media.poster ? (
          <img class="project-poster" src={media.poster} alt={`${title} preview`} />
        ) : (
          <div class="media-placeholder" aria-hidden="true"></div>
        )}
        <div class="card-veil"></div>
      </div>
    </div>
  </div>

  <div class="card-content">
    <h3 class="title">{title}</h3>
    <p class="description">{description}</p>

    {tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )}

    <div class="links">
      {links.github && (
        <a class="link" href={links.github} target="_blank" rel="noopener noreferrer">
          View on GitHub →
        </a>
      )}
      {links.live && (
        <a class="link" href={links.live} target="_blank" rel="noopener noreferrer">
          View live →
        </a>
      )}
    </div>
  </div>
</article>

<style>
    .project-card {
        height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        padding: 3rem 2rem;
        box-sizing: border-box;
        margin-bottom: 30vh;
        margin-top: 0vh;
        position: relative;
        z-index: 1;
    }

    /* Odd cards: media on the left, caption fills the space to the right.
       Even cards: mirrored. Real flex layout, not a visual illusion, so
       card-content genuinely occupies the room media-frame leaves open. */
    .project-card:nth-of-type(odd) {
        flex-direction: row;
    }

    .project-card:nth-of-type(even) {
        flex-direction: row-reverse;
    }

    .project-video,
    .project-poster,
    .project-gif {
          width: 100%;
          height: 100%;
          object-fit: cover;
    }

    /* Hidden by default; only shown in place of the animated gif when the
       user prefers reduced motion (see prefers-reduced-motion block below). */
    .project-gif-fallback {
        display: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .project-gif {
            display: none;
        }

        .project-gif-fallback {
            display: block;
        }
    }

    .media-frame {
        position: relative;
        flex: 0 1 60%;
        height: 80%;
        max-height: 80vh;
        transform: scale(0.92);
        transition: transform 0.8s ease;
    }

    /* Gif cards: derive height from width via the gif's own aspect ratio
       (set inline as --gif-aspect-ratio) rather than the fixed 80%/80vh
       box above, so the frame matches what's actually playing instead of
       cropping it via object-fit. max-height stays on as a clamp for
       unusually tall (portrait) gifs — past that point the image will
       letterbox/crop slightly rather than blowing out the row's height. */
    .media-frame[data-has-gif] {
        height: auto;
        aspect-ratio: var(--gif-aspect-ratio);
    }

    /* Clickable affordance — only when the card actually has a link to go
       to (data-href present). Focus-visible ring for keyboard users since
       this is a div acting as a link (role="link"/tabindex added inline). */
    .media-frame[data-href] {
        cursor: pointer;
    }

    .media-frame[data-href]:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
    }

    /* Pure CSS hover — deliberately not GSAP. Nothing else ever writes to
       .media-frame's transform (GSAP only touches .push-anchor's and
       .media-visual's), so this has zero competition and no merge-order
       dependency. Gated the same way the JS tilt effect is, so touch/
       no-hover devices simply keep the resting scale with no dead hover
       state to trip over. */
    @media (hover: hover) and (pointer: fine) {
        .media-frame:hover {
            transform: scale(0.96);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .media-frame {
            transition: none;
        }
    }

    /* Owns ONLY the pointer-driven push translation (x/y). Kept separate
       from .media-visual (which owns rotation/rotationX/rotationY from the
       floating idle tween + tilt) so no two GSAP tweens ever fight over
       the same transform properties on the same element. */
    .push-anchor {
      position: relative;
      width: 100%;
      height: 100%;
      /* Required so .media-frame's perspective still reaches .media-visual's
         rotationX/rotationY — without this, this element's own transform
         (the push translation) creates a flat 2D boundary that blocks the
         3D context from passing through to its child. */
      transform-style: preserve-3d;
    }

    .media-visual {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      border-radius: 8px;
    }

    .card-veil {
      position: absolute;
      inset: 0;
      background: var(--color-shallow);
      opacity: 0;
      mix-blend-mode: multiply;
      pointer-events: none;
      z-index: 2;
    }

    .media-placeholder {
        width: 100%;
        height: 100%;
        background: #f0f0f0;
    }

    /* Sibling of media-frame, not overlaid on top of it — sits in the
       flex space media-frame leaves open beside it. */
    .card-content {
        flex: 1 1 260px;
        max-width: 380px;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.25rem 1.5rem;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(6px);
        color: #fff;
        border-radius: 8px;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0.5rem 0;
    }

    .tag {
        font-size: 0.8rem;
        padding: 0.25rem 0.6rem;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 999px;
    }

    .links {
        display: flex;
        gap: 1rem;
    }

    .link {
        color: #fff;
    }

    @media (max-width: 800px) {
        /* Stacked layout doesn't need the desktop's 30vh scroll buffer
           between cards or a hard-locked 100vh — let the card size to
           its actual content (gif/media + caption stacked) and just set
           a floor so short cards still get a full-screen "arrival" feel. */
        .project-card,
        .project-card:nth-of-type(even) {
            flex-direction: column;
            height: auto;
            min-height: 100vh;
            gap: 1.25rem;
            padding: 4rem 1.25rem;
            margin-bottom: 8rem;
        }

        .media-frame {
            flex: 0 1 auto;
            width: 100%;
            /* Desktop's height: 80%/max-height: 80vh (set on the base
               .media-frame rule) assumed a fixed-height row with content
               beside it, not above/below — on a narrow column that would
               eat most of the card and leave the caption crushed into a
               sliver underneath. Let height come from content instead. */
            height: auto;
            max-height: none;
        }

        /* Gif cards already get their own aspect-ratio from
           --gif-aspect-ratio (see .media-frame[data-has-gif] above) at
           any breakpoint, so this only needs to give video/poster cards
           — which have no intrinsic ratio to size by — a sane fallback
           box instead of an unbounded one. */
        .media-frame:not([data-has-gif]) {
            aspect-ratio: 16 / 9;
        }

        .card-content {
            max-width: none;
            width: 100%;
        }
    }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>('.media-visual').forEach((visual) => {
    const x = gsap.utils.random(-50, 50);
    const y = gsap.utils.random(-20, 20);
    const veil = visual.querySelector<HTMLElement>('.card-veil');

    // suspended/floating in water effect
    gsap.fromTo(
      visual,
      { rotation: -0.4 },
      {
        rotation: 0.4,
        x,
        y,
        transformOrigin: 'center center',
        duration: 2.3,
        ease: 'sine.inOut',
        scrollTrigger: visual,
        toggleActions: 'restart pause none none',
        repeat: -1,
        yoyo: true,
      }
    );

    // depth effect: card is clearest/sharpest centered in viewport,
    // blurs and dims toward the top/bottom edges of its scroll range
    // clear as it rises from bottom to center
    gsap.fromTo(
      visual,
      { filter: 'blur(6px) saturate(0.5) brightness(0.8)' },
      {
        filter: 'blur(0px) saturate(1) brightness(1)',
        ease: 'none',
        scrollTrigger: {
          trigger: visual,
          start: 'top bottom',
          end: '80% bottom',
          scrub: true,
        },
      }
    );

    // blurs again as it continues past center toward the top
    gsap.fromTo(
      visual,
      { filter: 'blur(0px) saturate(1) brightness(1)' },
      {
        filter: 'blur(6px) saturate(0.5) brightness(0.8)',
        ease: 'none',
        scrollTrigger: {
          trigger: visual,
          start: '20% top',
          end: 'bottom top',
          scrub: true,
        },
      }
    );

    // veil tints in/out on the same schedule as the blur
    if (veil) {
      gsap.fromTo(
        veil,
        { opacity: 0.75 },
        {
          opacity: 0,
          ease: 'none',
          scrollTrigger: {
            trigger: visual,
            start: 'top bottom',
            end: '80% bottom',
            scrub: true,
          },
        }
      );

      gsap.fromTo(
        veil,
        { opacity: 0 },
        {
          opacity: 0.75,
          ease: 'none',
          scrollTrigger: {
            trigger: visual,
            start: '20% top',
            end: 'bottom top',
            scrub: true,
          },
        }
      );
    }

    // Caption starts invisible. It only fades in once the card has been
    // substantially in view for a sustained 2 seconds — a real timer, not
    // tied to scroll position, so quickly scrolling past doesn't trigger
    // it. Fading OUT, though, mirrors the exact same scroll-scrubbed
    // schedule the veil re-tints on (20% top → bottom top), so the
    // caption disappears in lockstep with the rest of the card blurring
    // back out, rather than on its own timer.
    const cardContent = visual.closest<HTMLElement>('.project-card')?.querySelector<HTMLElement>('.card-content');
    if (cardContent) {
      gsap.set(cardContent, { opacity: 0 });

      let revealTimeout: ReturnType<typeof setTimeout> | undefined;

      const clearRevealTimer = () => {
        if (revealTimeout) {
          clearTimeout(revealTimeout);
          revealTimeout = undefined;
        }
      };

      // Entrance: wait 2s of continuous "in view" before fading in.
      ScrollTrigger.create({
        trigger: visual,
        start: 'top 85%',
        end: 'bottom 15%',
        onEnter: () => {
          clearRevealTimer();
          revealTimeout = setTimeout(() => {
            gsap.to(cardContent, { opacity: 1, duration: 1, ease: 'power2.out', overwrite: 'auto' });
          }, 1000);
        },
        onEnterBack: () => {
          clearRevealTimer();
          revealTimeout = setTimeout(() => {
            gsap.to(cardContent, { opacity: 1, duration: 1, ease: 'power2.out', overwrite: 'auto' });
          }, 1000);
        },
        onLeave: () => clearRevealTimer(),
        onLeaveBack: () => clearRevealTimer(),
      });

      // Exit: scroll-scrubbed, matching the veil's own re-tint window
      // exactly, so the caption vanishes in sync with the media blurring
      // back out. This is deliberately NOT a gsap.fromTo() tween — a
      // fromTo's "from" value gets rendered as soon as scroll progress is
      // 0, which is true for the ENTIRE time before the card reaches this
      // zone (i.e. the whole time it's sitting in view). That was
      // silently forcing opacity back to 1 the instant this was created,
      // overriding the 2s timer entirely — which is why the caption was
      // showing up immediately instead of waiting. Driving it manually in
      // onUpdate, gated by self.isActive, means this only ever touches
      // opacity while genuinely between start and end; outside that
      // window it leaves the property alone so the timer stays in
      // control.
      ScrollTrigger.create({
        trigger: visual,
        start: '20% top',
        end: 'bottom top',
        scrub: true,
        onUpdate: (self) => {
          if (self.isActive) {
            gsap.set(cardContent, { opacity: 1 - self.progress });
          }
        },
        onLeave: () => gsap.set(cardContent, { opacity: 0 }),
      });
    }
  });

  // Media-frame click-through: same destination as the card's "View on
  // GitHub" (or "View live") link. Reads data-href set server-side from
  // links.github ?? links.live, so there's a single source of truth for
  // the destination rather than duplicating link logic in JS.
  gsap.utils.toArray<HTMLElement>('.media-frame[data-href]').forEach((frame) => {
    const href = frame.dataset.href;
    if (!href) return;

    const openLink = () => {
      window.open(href, '_blank', 'noopener,noreferrer');
    };

    frame.addEventListener('click', openLink);

    frame.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLink();
      }
    });
  });

  // Pointer tilt + water-push
  const supportsHoverTilt = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const tiltReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (supportsHoverTilt && !tiltReducedMotion) {
    gsap.utils.toArray<HTMLElement>('.media-frame').forEach((frame) => {
      gsap.set(frame, { perspective: 650 });

      const visual = frame.querySelector<HTMLElement>('.media-visual');
      const pushAnchor = frame.querySelector<HTMLElement>('.push-anchor');
      const content = frame.parentElement?.querySelector<HTMLElement>('.card-content') ?? null;
      if (!visual) return;

      const TILT_MAX = 4; // deg, hard clamp — tilt can never exceed this in either direction
      const PUSH_MAX = 70; // px, hard clamp — push can never exceed this in either direction

      const TILT_EXTEND = 70; // px beyond the frame's actual edge where the tilt/content "which direction" reading still keeps sharpening, instead of maxing out right at the boundary
      const APPROACH_BUFFER = 280; // px beyond the frame's edge where the whole field (tilt + push) fades to nothing

      const CONTENT_APPROACH_DURATION = 0.5;
      const CONTENT_RETURN_DURATION = 1.3;

      // How fast the accumulators climb toward TILT_MAX / PUSH_MAX per
      // second of continuous full-strength approach — e.g. TILT_MAX / 0.8
      // means it takes ~0.8s of holding the cursor right at the object to
      // reach full tilt. Still noticeably softer than an instant snap,
      // but fast enough to register on a normal hover. Lower the divisor
      // (e.g. / 0.4) for snappier, raise it (e.g. / 2) for softer.
      const TILT_APPROACH_RATE_PER_SEC = TILT_MAX / 0.8;
      const PUSH_APPROACH_RATE_PER_SEC = PUSH_MAX / 0.8;

      // How much of the current tilt/push value survives each second while
      // retreating — 0.15 means ~15% remains after 1s (a fast-ish decay);
      // closer to 1 = slower, more lingering drift back to neutral.
      const TILT_RETURN_DECAY_PER_SEC = 0.2;
      const PUSH_RETURN_DECAY_PER_SEC = 0.28;

      let previousStrength = 0;
      let isApproaching = false;

      // Direction/strength read fresh on every pointermove, but NOT
      // applied to the accumulators there — that was the source of the
      // "very aggressive, near-instant" feel. A fast mouse movement fires
      // a burst of pointermove events within a fraction of a second, so
      // nudging per-event let the accumulator hit its clamp almost
      // immediately regardless of how small the per-event step was. These
      // are just the latest reading; the ticker below is what actually
      // moves the accumulators, at a fixed rate per second of real time
      // — so total approach speed is bounded by TILT_APPROACH_RATE_PER_SEC
      // / PUSH_APPROACH_RATE_PER_SEC, not by event frequency.
      let latestTiltNormX = 0;
      let latestTiltNormY = 0;
      let latestPushNormX = 0;
      let latestPushNormY = 0;
      let latestStrength = 0;

      // Tilt and push are accumulators, not absolute targets — nudged
      // gradually toward their max in the "away from cursor" direction
      // rather than computing a fresh target from scratch each time
      // (which used to cause a "resets to a starting point" glitch).
      // Applied to the DOM every animation frame via gsap.ticker below
      // (using quickSetter, not gsap.to), so both the approach ramp and
      // the return decay run smoothly over real time — a single thing
      // writing to these properties once per frame, with no tweens to
      // fight over them.
      let tiltRotationX = 0;
      let tiltRotationY = 0;
      let pushOffsetX = 0;
      let pushOffsetY = 0;

      const setRotationX = gsap.quickSetter(visual, 'rotationX', 'deg');
      const setRotationY = gsap.quickSetter(visual, 'rotationY', 'deg');
      const setPushX = pushAnchor ? gsap.quickSetter(pushAnchor, 'x', 'px') : null;
      const setPushY = pushAnchor ? gsap.quickSetter(pushAnchor, 'y', 'px') : null;

      window.addEventListener('pointermove', (e: PointerEvent) => {
        const rect = frame.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const halfWidth = rect.width / 2;
        const halfHeight = rect.height / 2;
        const dx = e.clientX - centerX;
        const dy = e.clientY - centerY;

        const closestX = gsap.utils.clamp(rect.left, rect.right, e.clientX);
        const closestY = gsap.utils.clamp(rect.top, rect.bottom, e.clientY);
        const edgeDx = e.clientX - closestX;
        const edgeDy = e.clientY - closestY;
        const edgeDistance = Math.sqrt(edgeDx * edgeDx + edgeDy * edgeDy);
        const strength = gsap.utils.clamp(0, 1, 1 - edgeDistance / APPROACH_BUFFER);

        const approaching = strength >= previousStrength;
        previousStrength = strength;
        isApproaching = approaching && strength > 0.001;
        latestStrength = strength;

        const contentDuration = approaching ? CONTENT_APPROACH_DURATION : CONTENT_RETURN_DURATION;
        const contentEase = approaching ? 'power3' : 'power2.out';

        if (strength <= 0.001) {
          if (content) gsap.to(content, { x: 0, y: 0, duration: contentDuration, ease: contentEase, overwrite: 'auto' });
          return;
        }

        // "Which direction is away from the cursor" — recorded for the
        // ticker to use; not applied here.
        latestPushNormX = gsap.utils.clamp(-1, 1, dx / halfWidth);
        latestPushNormY = gsap.utils.clamp(-1, 1, dy / halfHeight);
        latestTiltNormX = gsap.utils.clamp(-1, 1, dx / (halfWidth + TILT_EXTEND));
        latestTiltNormY = gsap.utils.clamp(-1, 1, dy / (halfHeight + TILT_EXTEND));

        // Content always tracks the cursor directly, approach or return.
        if (content) {
          gsap.to(content, {
            x: 6 * latestTiltNormX * strength,
            y: 6 * latestTiltNormY * strength,
            duration: contentDuration,
            ease: contentEase,
            overwrite: 'auto',
          });
        }
      });

      // Runs every animation frame regardless of pointer activity.
      // Approaching: nudges the accumulators toward TILT_MAX/PUSH_MAX in
      // the latest known direction, at a fixed rate per second (frame-rate
      // independent via gsap.ticker.deltaRatio) — this is what makes the
      // approach itself soft/gradual instead of near-instant.
      // Retreating: decays the accumulators toward 0 the same way.
      gsap.ticker.add(() => {
        const dt = gsap.ticker.deltaRatio(60) / 60; // seconds elapsed this tick, frame-rate independent

        if (isApproaching) {
          tiltRotationX = gsap.utils.clamp(
            -TILT_MAX,
            TILT_MAX,
            tiltRotationX + -latestTiltNormY * latestStrength * TILT_APPROACH_RATE_PER_SEC * dt
          );
          tiltRotationY = gsap.utils.clamp(
            -TILT_MAX,
            TILT_MAX,
            tiltRotationY + latestTiltNormX * latestStrength * TILT_APPROACH_RATE_PER_SEC * dt
          );
          pushOffsetX = gsap.utils.clamp(
            -PUSH_MAX,
            PUSH_MAX,
            pushOffsetX + -latestPushNormX * latestStrength * PUSH_APPROACH_RATE_PER_SEC * dt
          );
          pushOffsetY = gsap.utils.clamp(
            -PUSH_MAX,
            PUSH_MAX,
            pushOffsetY + -latestPushNormY * latestStrength * PUSH_APPROACH_RATE_PER_SEC * dt
          );
        } else {
          const tiltDecay = Math.pow(TILT_RETURN_DECAY_PER_SEC, dt);
          const pushDecay = Math.pow(PUSH_RETURN_DECAY_PER_SEC, dt);

          tiltRotationX *= tiltDecay;
          tiltRotationY *= tiltDecay;
          pushOffsetX *= pushDecay;
          pushOffsetY *= pushDecay;

          // Snap tiny residual values to exactly 0 so it fully settles
          // instead of decaying asymptotically forever.
          if (Math.abs(tiltRotationX) < 0.001) tiltRotationX = 0;
          if (Math.abs(tiltRotationY) < 0.001) tiltRotationY = 0;
          if (Math.abs(pushOffsetX) < 0.05) pushOffsetX = 0;
          if (Math.abs(pushOffsetY) < 0.05) pushOffsetY = 0;
        }

        setRotationX(tiltRotationX);
        setRotationY(tiltRotationY);
        setPushX?.(pushOffsetX);
        setPushY?.(pushOffsetY);
      });
    });
  }
</script>