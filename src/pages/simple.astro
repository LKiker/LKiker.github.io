---
import SimpleLayout from "../layouts/SimpleLayout.astro";
import ProjectListItem from "../components/ProjectListItem.astro";
import { projects } from '../data/projects';
import SkillCategory from "../components/SkillCategory.astro";
import { skillCategories } from "../data/skills";

const pageTitle = "Simple View";
---

<SimpleLayout pageTitle={pageTitle}>
    <!-- About Me -->
    <section class="about-section">
        <h2>About Me</h2>
        <p>I build for the web, in VR, and the physical world.</p>
    </section>

    <!-- Skills -->
    <section class="skills-section">
        <h2>Skills</h2>
        {skillCategories.map((category) => (
            <SkillCategory category={category} />
        ))}
    </section>

    <!-- Projects -->
    <section class="projects-section">
        <h2>Projects</h2>
        {projects.map((project) => (
            <ProjectListItem project={project} />
        ))}
    </section>

    <a href="/">Back to Home</a>
</SimpleLayout>

<style>
    section {
        max-width: 720px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
    }

    .skills-section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    h2 {
        margin-bottom: 1.5rem;
    }
</style>