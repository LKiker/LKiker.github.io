---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import DepthGauge from "../components/DepthGauge.astro";
import HeroSeascape from "../components/HeroSeascape.astro";
import SunRays from '../components/SunRays.astro';
import { projects } from '../data/projects';

const pageTitle = "Portfolio"
---
<Layout pageTitle={pageTitle}>
    <DepthGauge />

    <div class="hero">
        <!-- <HeroSeascape />
        <SunRays /> -->
        <a href="/simple/" class="simple-view-link">simple view</a>

        <div class="hero-content">
            <h1>Landrey Kiker</h1>
            <h2>Web Developer</h2>
            <p>
                I build for the web, in VR, and soon in
                the physical world, chasing the same curiosity that
                keeps me staring into aquariums.
            </p>
        </div>
    </div>

    <div class="projects-page">
        <div class="projects-list">
            {projects.map((project) => (
                <ProjectCard project={project} />
            ))}
        </div>
    </div>
</Layout>

<style>
    .hero {
        position: relative; /* HeroSeascape's canvas anchors to this */
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--color-surface-text);
        overflow: hidden;
    }

    .simple-view-link {
        position: absolute;
        top: 1.5rem;
        left: 1.5rem;
        z-index: 1; /* above the canvas */
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        color: var(--color-ink-muted);
        opacity: 0.75;
        text-decoration: none;
        transition: opacity 0.2s ease, color 0.2s ease;
    }

    .simple-view-link:hover {
        opacity: 1;
        color: var(--color-ink);
    }

    .hero-content {
        position: relative;
        z-index: 2; /* above the canvas */
        max-width: 40ch;
    }

    .hero-content h1 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: clamp(2rem, 5vw, 2.5rem);
        letter-spacing: -0.01em;
        margin: 0;
    }

    .hero-content h2 {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 0.9rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin: 0.5rem 0 1.1rem;
    }

    .hero-content p {
        font-family: var(--font-body);
        font-size: 0.9rem;
        line-height: 1.7;
        color: var(--color-surface-text);
        margin: 0;
    }

    .projects-page {
        max-width: 80%;
        margin: 0 auto;
        padding: 4rem 1.5rem;
    }

    .projects-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .project-card:last-child {
        margin-bottom: 0;
    }
</style>