---
import HomepageLayout from "../layouts/HomepageLayout.astro";

const pageTitle = "Portfolio"
---
<HomepageLayout pageTitle={pageTitle}>
    <div class="hero">
        <a href="/simple/" class="simple-view-link">simple view</a>

        <div class="depth-readout">
            <span class="depth-label">depth</span>
            <span class="depth-value">0.0<span class="depth-unit">m</span></span>
        </div>

        <div class="hero-content">
            <h1>Landrey Kiker</h1>
            <h2>Web Developer</h2>
            <p>
                I build for the web, in VR, and soon in
                the physical world, chasing the same curiosity that
                keeps me staring into aquariums.
            </p>
        </div>

        <a href="/projects/" class="dive-link">dive into projects →</a>
    </div>
</HomepageLayout>

<style>
    .hero {
        position: relative;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--color-surface-text);
        overflow: hidden;
    }

    .simple-view-link {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        color: var(--color-ink-muted);
        opacity: 0.75;
        text-decoration: none;
        transition: opacity 0.2s ease, color 0.2s ease;
    }

    .simple-view-link:hover {
        opacity: 1;
        color: var(--color-ink);
    }

    .depth-readout {
        position: absolute;
        top: 1.5rem;
        left: 1.5rem;
        font-family: var(--font-mono);
        color: var(--color-accent);
        letter-spacing: 0.06em;
        text-align: left;
    }

    .depth-label {
        display: block;
        font-size: 0.6rem;
        opacity: 0.6;
        text-transform: uppercase;
    }

    .depth-value {
        font-size: 1.1rem;
        font-weight: 500;
    }

    .depth-unit {
        font-size: 0.7rem;
    }

    .hero-content {
        max-width: 40ch;
    }

    .hero-content h1 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: clamp(2rem, 5vw, 2.5rem);
        letter-spacing: -0.01em;
        margin: 0;
    }

    .hero-content h2 {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 0.9rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin: 0.5rem 0 1.1rem;
    }

    .hero-content p {
        font-family: var(--font-body);
        font-size: 0.9rem;
        line-height: 1.7;
        color: var(--color-ink-muted);
        margin: 0;
    }

    .dive-link {
        display: inline-block;
        margin-top: 2rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        padding: 0.75rem 1.6rem;
        border-radius: 999px;
        text-decoration: none;
        color: var(--color-abyss);
        background: var(--color-accent);
        transition: transform 0.2s ease;
    }

    .dive-link:hover {
        transform: scale(1.05);
    }
</style>